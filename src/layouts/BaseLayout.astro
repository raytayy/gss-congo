---
/*
 * BaseLayout — every page is wrapped here.
 * - Self-hosted variable fonts via app.css
 * - View Transitions (decision B9)
 * - Skip link first-focusable (WCAG 2.2)
 * - Grain overlay (BRAND §8.2)
 * - Per-page <head> via SEO props
 *
 * Source of truth: design/BRAND.md
 */

import { ClientRouter } from 'astro:transitions';
import '@styles/app.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileActionBar from '@components/MobileActionBar.astro';
import MotionRoot from '@components/MotionRoot.astro';
import CookieBanner from '@components/CookieBanner.astro';
import { ui, t } from '@lib/i18n';
import { localBusinessSchema } from '@lib/jsonld';

// GA4 + Consent Mode v2. Loaded build-time; if PUBLIC_GA4_ID is absent
// (test environment, no client property yet) no analytics markup ships.
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? '';
const hasGa4 = ga4Id.startsWith('G-');

interface Props {
  title: string;
  description: string;
  lang?: 'fr' | 'en';
  /** Path of the current page in the OTHER locale, for hreflang. */
  altLocaleHref?: string;
  /** Optional og:image absolute URL. Defaults to /og-default.jpg. */
  ogImage?: string;
  /** Optional per-page JSON-LD schema(s) appended after the global LocalBusiness. */
  jsonLd?: object | object[];
}

const {
  title,
  description,
  lang = 'fr',
  altLocaleHref,
  ogImage = '/og-default.jpg',
  jsonLd,
} = Astro.props;

const altLocale = lang === 'fr' ? 'en' : 'fr';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com';

// hreflang URLs — all absolute. x-default points at the FR equivalent of the
// current page (derived by swapping the locale segment) so Google routes
// language-undeclared visitors to the default locale.
const altLocaleURL = altLocaleHref
  ? new URL(altLocaleHref, Astro.site).toString()
  : null;
const xDefaultURL = lang === 'fr'
  ? canonicalURL
  : (altLocaleURL ?? canonicalURL.replace(`/${lang}/`, '/fr/'));

// Global LocalBusiness + page-specific schemas
const orgSchema = localBusinessSchema(lang, siteUrl);
const extraSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title} · GSS Congo</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    {/* Self-reference first — Google's hreflang clustering requires that
        every page lists its own version. Then the alternate locale, then
        x-default which points at the FR canonical. All URLs absolute.
        Tags are BCP-47 with the CD (DRC) region suffix to match the
        sitemap and JSON-LD inLanguage values. */}
    <link rel="alternate" hreflang={lang === 'fr' ? 'fr-CD' : 'en-CD'} href={canonicalURL} />
    {altLocaleURL && (
      <link rel="alternate" hreflang={altLocale === 'fr' ? 'fr-CD' : 'en-CD'} href={altLocaleURL} />
    )}
    <link rel="alternate" hreflang="x-default" href={xDefaultURL} />

    {/* Open Graph + Twitter — single source of truth for share previews. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GSS Congo" />
    <meta property="og:title" content={`${title} · GSS Congo`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_CD' : 'en_CD'} />
    {lang === 'fr' && <meta property="og:locale:alternate" content="en_CD" />}
    {lang === 'en' && <meta property="og:locale:alternate" content="fr_CD" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · GSS Congo`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    {/* Favicon — official brand mark */}
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    {/* PWA manifest — written by the asset agent. */}
    <link rel="manifest" href="/site.webmanifest" />

    {/* Theme colour matches ink for PWA / browser chrome */}
    <meta name="theme-color" content="#0E2E4A" />

    {/* View Transitions — Astro native (decision B9) */}
    <ClientRouter />

    {/* JSON-LD: global organisation + per-page schemas */}
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    {/* GA4 with Consent Mode v2 — analytics_storage defaults to DENIED.
        The CookieBanner emits `gss:consent-change` to update the state
        only after explicit opt-in. Loaded only if PUBLIC_GA4_ID is set. */}
    {hasGa4 && (
      <Fragment>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ window.dataLayer.push(arguments); }
          window.gtag = gtag;

          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            wait_for_update: 500,
          });

          gtag('js', new Date());
          gtag('config', ga4Id, { anonymize_ip: true, send_page_view: false });

          // Honour any existing decision so return visitors aren't re-prompted.
          try {
            if (localStorage.getItem('gss-consent') === 'granted') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            }
          } catch (e) {}

          // React to fresh decisions from the CookieBanner.
          document.addEventListener('gss:consent-change', function (e) {
            gtag('consent', 'update', { analytics_storage: e.detail.analytics });
          });

          // Track Astro View Transition page-changes as page_view events.
          document.addEventListener('astro:page-load', function () {
            gtag('event', 'page_view', {
              page_path: location.pathname + location.search,
              page_title: document.title,
            });
          });
        </script>
      </Fragment>
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">{t(ui.a11y.skipToContent, lang)}</a>

    <MotionRoot />

    <div class="grain" aria-hidden="true"></div>

    <Header locale={lang} currentPath={currentPath} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={lang} />

    <MobileActionBar locale={lang} />

    <CookieBanner locale={lang} />

    {/* Web3Forms redirect rewrite — the redirect input is baked at
        build time as https://gss-congo.com/<locale>/merci/, but until
        DNS cuts over to the production host (and on Vercel previews
        in the meantime), that URL doesn't resolve. Rewrite it on
        submit using window.location.origin so the redirect lands on
        the same host the user is browsing. */}
    <script is:inline>
      (function () {
        function rewriteRedirects() {
          document.querySelectorAll('form[action*="web3forms.com"]').forEach(function (form) {
            if (form.dataset.redirectRewritten === '1') return;
            form.dataset.redirectRewritten = '1';
            form.addEventListener('submit', function () {
              var input = form.querySelector('input[name="redirect"]');
              if (!input) return;
              try {
                var u = new URL(input.value);
                input.value = window.location.origin + u.pathname + u.search + u.hash;
              } catch (e) {
                var path = input.value.startsWith('/') ? input.value : '/' + input.value;
                input.value = window.location.origin + path;
              }
            });
          });
        }
        rewriteRedirects();
        document.addEventListener('astro:page-load', rewriteRedirects);
      })();
    </script>
  </body>
</html>
