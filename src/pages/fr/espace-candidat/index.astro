---
/*
 * /fr/espace-candidat/ — Candidate enrolment form (FR).
 *
 * Simple Web3Forms-backed inscription. No Supabase, no lookup, no
 * status tracking (deferred). The Supabase helpers in src/lib/candidate.ts
 * + the CandidatePortal React island stay in the repo for the day we
 * wire real persistence — they just aren't mounted here.
 *
 * Mirror in src/pages/en/candidate-space/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

// Candidates route through the centre de formation line.
const phoneTel = `tel:${contact.phones.training[0].tel}`;
const phoneDisplay = contact.phones.training[0].display;
---

<BaseLayout
  title="Espace candidat"
  description="Inscrivez-vous au centre de formation GSS Congo pour entrer dans la prochaine cohorte."
  lang="fr"
  altLocaleHref="/en/candidate-space/"
>
  <section class="ec" aria-labelledby="ec-heading">
    <div class="ec-frame">
      <p class="ec-eyebrow" data-reveal>Espace candidat</p>
      <h1 id="ec-heading" class="ec-title" data-reveal data-reveal-delay="120">
        Postuler au centre de formation.
      </h1>
      <p class="ec-sub" data-reveal data-reveal-delay="240">
        Remplissez ce formulaire pour entrer dans la prochaine cohorte.
        Nous accusons réception immédiatement et revenons vers vous sous
        7 jours ouvrés.
      </p>

      <div class="ec-form-wrap" data-reveal data-reveal-delay="360">
        {!isConfigured && (
          <p class="ec-notice" role="status">
            <strong>Formulaire en attente de configuration.</strong>
            En attendant, WhatsApp et téléphone restent ouverts.
          </p>
        )}

        <form
          class="ec-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/fr/merci/`} />
          <input type="hidden" name="from_name" value="GSS Congo — inscription formation" />
          <input type="hidden" name="subject" value="Nouvelle inscription formation depuis gss-congo.com" />
          <input type="checkbox" name="botcheck" class="ec-honeypot" tabindex="-1" autocomplete="off" />

          <div class="ec-row">
            <label class="ec-field">
              <span class="ec-label">Nom complet *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="ec-field">
              <span class="ec-label">Téléphone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="ec-field">
            <span class="ec-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <div class="ec-row">
            <label class="ec-field">
              <span class="ec-label">Entreprise (le cas échéant)</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
            <label class="ec-field">
              <span class="ec-label">Type d'inscription</span>
              <select name="type">
                <option value="individuel">Individuel</option>
                <option value="equipe">Équipe (RH d'entreprise)</option>
                <option value="diplomatique">Poste de sécurité diplomatique</option>
              </select>
            </label>
          </div>

          <label class="ec-field">
            <span class="ec-label">Quelques mots sur votre contexte</span>
            <textarea name="message" rows="4" placeholder="Disponibilité, effectif à former, contraintes…"></textarea>
          </label>

          <p class="ec-fineprint">
            Vos informations restent confidentielles et ne sont utilisées
            que pour le traitement de votre inscription.
          </p>

          <div class="ec-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Envoyer mon inscription
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>

      <p class="ec-help">
        Une question avant de postuler ?
        <a href={phoneTel}>{phoneDisplay}</a>
        <span aria-hidden="true">·</span>
        <a href={whatsappLink("Bonjour GSS, je vous contacte depuis votre site. Je souhaite m'inscrire au centre de formation. Merci de me recontacter.")} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <span aria-hidden="true">·</span>
        <a href="/fr/centre-de-formation/">Revoir le centre de formation</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Page chrome ──────────────────────────────────────────── */
  .ec {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(7rem, 14vw, 12rem) clamp(1.5rem, 5vw, 4rem) clamp(5rem, 10vw, 9rem);
    min-height: 80vh;
  }
  .ec-frame { max-width: 720px; margin-inline: auto; }
  .ec-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ec-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .ec-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    max-width: 16em;
    text-wrap: balance;
  }
  .ec-sub {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 38em;
  }

  /* ─── Form ─────────────────────────────────────────────────── */
  .ec-form-wrap {
    background: var(--color-cream-2);
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .ec-notice {
    margin: 0 0 1.25rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    border: 1px solid var(--color-bronze);
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .ec-notice strong { color: var(--color-bronze-deep); font-weight: 500; }
  .ec-form { display: flex; flex-direction: column; gap: 1rem; }
  .ec-row { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .ec-row { grid-template-columns: 1fr 1fr; } }
  .ec-honeypot {
    position: absolute; left: -9999px; width: 1px; height: 1px;
    opacity: 0; pointer-events: none;
  }
  .ec-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .ec-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    font-weight: 500;
  }
  .ec-field input[type="text"],
  .ec-field input[type="email"],
  .ec-field input[type="tel"],
  .ec-field select,
  .ec-field textarea {
    width: 100%;
    padding: 0.7rem 0.875rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: var(--color-cream);
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
  }
  .ec-field input:focus,
  .ec-field select:focus,
  .ec-field textarea:focus {
    outline: none;
    border-color: var(--color-bronze);
    box-shadow: 0 0 0 3px oklch(70% 0.10 70 / 0.20);
  }
  .ec-field textarea { resize: vertical; min-height: 6.5rem; }
  .ec-fineprint {
    margin: 0.25rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-mute-on-light);
  }
  .ec-actions { margin-top: 0.5rem; }

  /* ─── Help line (phone / WhatsApp / back) ──────────────────── */
  .ec-help {
    margin: 0;
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--color-hairline-on-light);
    font-size: 0.9375rem;
    color: var(--color-mute-on-light);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.875rem;
    align-items: center;
  }
  .ec-help a {
    color: var(--color-bronze-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline-on-light);
    padding-bottom: 0.1rem;
    transition: border-color var(--duration-normal) var(--ease-out-expo);
  }
  .ec-help a:hover { border-bottom-color: var(--color-bronze); }
  .ec-help span[aria-hidden] { color: var(--color-bronze); opacity: 0.6; }
</style>
