---
/*
 * /fr/centre-de-formation/ — Training centre (FR).
 * Personas: P2 (embassy rigour signal) + P5 (recruit funnel).
 * Beats: Hero → Manifeste → Programmes → Domaines → Cycle → Localisation → CTA.
 * Mirror in src/pages/en/training-centre/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const programmes = [
  {
    name: 'Agent de prévention et de sécurité',
    body: 'Le tronc commun. Cadre légal, gestion d’accès, posture, prise de notes, communication radio, gestion de conflit.',
  },
  {
    name: 'Sécurité incendie & premiers secours',
    body: 'Modules type SSIAP : prévention incendie, évacuation, manipulation des extincteurs, gestes qui sauvent.',
  },
  {
    name: 'Cynophile & maître-chien',
    body: 'Travail en binôme avec chien d’intervention : dressage, commandement, lecture comportementale, dissuasion encadrée.',
  },
  {
    name: 'Conduite défensive & escorte',
    body: 'Étude d’itinéraire, anticipation, conduite sous pression, coordination en convoi, posture en cas d’incident.',
  },
  {
    name: 'Protocole & sécurité d’élite',
    body: 'Tenue civile, étiquette diplomatique, oreillette discrète, lecture de salle, déplacements VIP.',
  },
];

const domains = [
  'Cadre juridique RDC',
  'Premiers secours',
  'Lutte incendie',
  'Contrôle d’accès',
  'Patrouille périmétrique',
  'Communication radio',
  'Gestion de conflit',
  'Déontologie',
  'Procédures d’intervention',
  'Conduite défensive',
  'Cynologie',
  'Protocole VIP',
];

const cycle = [
  {
    n: '01',
    title: 'Recrutement',
    body: 'Sélection en plusieurs entretiens. Vérification d’antécédents, contrôle médical, test physique. Aucun raccourci.',
  },
  {
    n: '02',
    title: 'Théorie',
    body: 'Cadre légal, déontologie, secourisme, prévention incendie. Évaluation écrite à chaque module — pas de passage automatique.',
  },
  {
    n: '03',
    title: 'Pratique',
    body: 'Mises en situation, contrôle d’accès, fouille, gestion de conflit, communication radio. Encadrés par des instructeurs opérationnels.',
  },
  {
    n: '04',
    title: 'Affectation',
    body: 'Évaluation finale, attestation, intégration sur site. Première semaine accompagnée d’un référent terrain.',
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
const trainingPhones = contact.phones.training;
const trainingAddress = contact.addresses.training;
---

<BaseLayout
  title="Centre de formation"
  description="Le centre de formation GSS forme nos agents et, sur demande, ceux d’autres maisons. Cadre légal, sécurité incendie, cynologie, conduite défensive, protocole."
  lang="fr"
  altLocaleHref="/en/training-centre/"
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/careers-graphique.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Centre de formation</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Nos agents ne sont pas recrutés. Ils sont formés.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        L’école interne tourne en continu — théorie, pratique, mises en situation,
        évaluation. C’est notre première exigence, pas un argument commercial.
        Les promotions y entrent sélectivement, et n’en sortent qu’avec attestation.
      </p>
    </div>
  </section>

  <!-- ─── MANIFESTE ───────────────────────────────────────────── -->
  <section class="cf-section cf-manifest" aria-labelledby="cf-manifest-heading">
    <div class="cf-manifest-frame">
      <p class="cf-eyebrow" data-reveal>Manifeste</p>
      <p id="cf-manifest-heading" class="cf-manifest-text" data-reveal data-reveal-delay="120">
        Un agent qui n’est pas formé n’est pas un agent — c’est un costume sur
        un site. La formation n’est pas une option : c’est ce qui distingue une
        ressource d’un risque.
      </p>
    </div>
  </section>

  <!-- ─── PROGRAMMES ──────────────────────────────────────────── -->
  <section class="cf-section cf-programmes" aria-labelledby="cf-programmes-heading">
    <div class="cf-programmes-frame">
      <div class="cf-programmes-head">
        <p class="cf-eyebrow" data-reveal>Programmes</p>
        <h2 id="cf-programmes-heading" class="cf-section-heading" data-reveal data-reveal-delay="100">
          Cinq cursus, un même standard.
        </h2>
        <p class="cf-programmes-sub" data-reveal data-reveal-delay="200">
          Chaque cursus comporte un tronc commun, un volet métier et une
          évaluation finale. Modules complémentaires sur demande pour les
          besoins B2B spécifiques.
        </p>
      </div>
      <ol class="cf-programmes-list">
        {programmes.map((p, i) => (
          <li
            class="cf-programme"
            data-reveal
            data-reveal-delay={String(150 + i * 90)}
            style={`--reveal-delay: ${150 + i * 90}ms;`}
          >
            <span class="cf-programme-num" aria-hidden="true">/ {String(i + 1).padStart(2, '0')}</span>
            <div class="cf-programme-text">
              <h3 class="cf-programme-name">{p.name}</h3>
              <p class="cf-programme-body">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── DOMAINES (curriculum chips) ─────────────────────────── -->
  <section class="cf-section cf-domains" aria-labelledby="cf-domains-heading">
    <div class="cf-domains-frame">
      <div class="cf-domains-head">
        <p class="cf-eyebrow" data-reveal>Domaines couverts</p>
        <h2 id="cf-domains-heading" class="cf-section-heading" data-reveal data-reveal-delay="100">
          Le détail du curriculum.
        </h2>
      </div>
      <ul class="cf-domains-grid" aria-label="Liste des domaines couverts par la formation">
        {domains.map((d, i) => (
          <li
            class="cf-domain-chip"
            data-reveal
            data-reveal-delay={String(120 + i * 50)}
            style={`--reveal-delay: ${120 + i * 50}ms;`}
          >
            <span class="cf-domain-bullet" aria-hidden="true"></span>
            <span class="cf-domain-text">{d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── CYCLE (dark band) ───────────────────────────────────── -->
  <section class="cf-section cf-cycle" aria-labelledby="cf-cycle-heading">
    <div class="cf-cycle-frame">
      <div class="cf-cycle-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Cycle de formation</p>
        <h2 id="cf-cycle-heading" class="cf-section-heading cf-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Quatre étapes, sans raccourci.
        </h2>
        <p class="cf-cycle-sub" data-reveal data-reveal-delay="200">
          Du premier entretien à l’affectation, le cheminement est lisible et
          contrôlé. Chaque étape se valide — ou se reprend.
        </p>
      </div>
      <ol class="cf-cycle-grid">
        {cycle.map((c, i) => (
          <li
            class="cf-cycle-step"
            data-reveal
            data-reveal-delay={String(150 + i * 100)}
            style={`--reveal-delay: ${150 + i * 100}ms;`}
          >
            <span class="cf-cycle-num">{c.n}</span>
            <h3 class="cf-cycle-title">{c.title}</h3>
            <p class="cf-cycle-body">{c.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── LOCALISATION ────────────────────────────────────────── -->
  <section class="cf-section cf-locate" aria-labelledby="cf-locate-heading">
    <div class="cf-locate-frame">
      <div class="cf-locate-text">
        <p class="cf-eyebrow" data-reveal>Localisation</p>
        <h2 id="cf-locate-heading" class="cf-section-heading" data-reveal data-reveal-delay="100">
          Le centre se visite, sur rendez-vous.
        </h2>
        <p class="cf-locate-sub" data-reveal data-reveal-delay="180">
          Les responsables RH des entreprises et les chefs de poste de sécurité
          diplomatique sont reçus sur place — pour visiter les salles, rencontrer
          les instructeurs, et lire le programme dans le détail.
        </p>
        <dl class="cf-locate-info" data-reveal data-reveal-delay="260">
          <div class="cf-locate-row">
            <dt class="cf-locate-label">Adresse</dt>
            <dd class="cf-locate-value">
              {trainingAddress.detail}<br />
              {trainingAddress.street}<br />
              {trainingAddress.city}, RDC
            </dd>
          </div>
          <div class="cf-locate-row">
            <dt class="cf-locate-label">Lignes formation</dt>
            <dd class="cf-locate-value cf-locate-phones">
              {trainingPhones.map((p) => (
                <a href={`tel:${p.tel}`}>{p.display}</a>
              ))}
            </dd>
          </div>
        </dl>
      </div>
      <div class="cf-locate-map" data-reveal data-reveal-delay="200">
        <iframe
          src="https://www.google.com/maps?q=Carrefour%20des%20Jeunes%20Victoire%20Kinshasa&z=15&output=embed"
          title="Centre de formation GSS : Carrefour des Jeunes, Victoire, Kinshasa"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="cf-locate-map-link" href={trainingAddress.mapsUrl} target="_blank" rel="noopener noreferrer">
          Ouvrir dans Google Maps
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── INSCRIPTION (form) ──────────────────────────────────── -->
  <section class="cf-cta" aria-labelledby="cf-cta-heading">
    <div class="cf-cta-frame">
      <div class="cf-cta-text" data-reveal>
        <p class="cf-eyebrow cf-eyebrow-on-dark">Inscription</p>
        <h2 id="cf-cta-heading" class="cf-cta-heading">
          Postuler, ou inscrire vos équipes.
        </h2>
        <p class="cf-cta-sub">
          Candidats individuels, RH d’entreprise, postes de sécurité diplomatique.
          Calendriers de promotions ou formation dédiée sur demande.
        </p>
        <p class="cf-cta-phone">
          Ou appelez-nous,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.fr}</span>
        </p>
        <p class="cf-cta-wa">
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cf-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cf-notice" role="status">
            <strong>Formulaire en attente de configuration.</strong>
            En attendant, WhatsApp et téléphone restent ouverts.
          </p>
        )}

        <form
          class="cf-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/fr/merci/`} />
          <input type="hidden" name="from_name" value="GSS Congo — inscription formation" />
          <input type="hidden" name="subject" value="Nouvelle inscription formation depuis gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Nom complet *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Téléphone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Entreprise (le cas échéant)</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Type d’inscription</span>
              <select name="type">
                <option value="individuel">Individuel</option>
                <option value="equipe">Équipe (RH d’entreprise)</option>
                <option value="diplomatique">Poste de sécurité diplomatique</option>
              </select>
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Programme souhaité</span>
            <select name="programme">
              <option value="">— Choisir un programme —</option>
              <option value="Agent de prévention et de sécurité">Agent de prévention et de sécurité</option>
              <option value="Sécurité incendie & premiers secours">Sécurité incendie &amp; premiers secours</option>
              <option value="Cynophile & maître-chien">Cynophile &amp; maître-chien</option>
              <option value="Conduite défensive & escorte">Conduite défensive &amp; escorte</option>
              <option value="Protocole & sécurité d’élite">Protocole &amp; sécurité d’élite</option>
              <option value="autre">Autre / à discuter</option>
            </select>
          </label>

          <label class="cf-field">
            <span class="cf-label">Quelques mots sur votre contexte</span>
            <textarea name="message" rows="4" placeholder="Disponibilité, effectif à former, contraintes…"></textarea>
          </label>

          <p class="cf-fineprint">
            Vos informations restent confidentielles et ne sont utilisées
            que pour le traitement de votre inscription.
          </p>

          <div class="cf-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Envoyer mon inscription
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 40em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-section {
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── MANIFESTE ────────────────────────────────────────────── */
  .cf-manifest {
    background: var(--color-cream);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .cf-manifest-frame { max-width: 920px; margin-inline: auto; }
  .cf-manifest-text {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 420, 'SOFT' 40;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* ─── PROGRAMMES ───────────────────────────────────────────── */
  .cf-programmes { background: var(--color-cream-2); }
  .cf-programmes-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 1024px) {
    .cf-programmes-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: start;
    }
  }
  .cf-programmes-head { max-width: 30rem; }
  .cf-programmes-sub {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
  }
  .cf-programmes-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .cf-programme {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-hairline-on-light);
    align-items: baseline;
  }
  .cf-programme:last-child { border-bottom: 1px solid var(--color-hairline-on-light); }
  .cf-programme-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.9375rem;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    padding-top: 0.25rem;
  }
  .cf-programme-text { display: flex; flex-direction: column; gap: 0.5rem; }
  .cf-programme-name {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .cf-programme-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 38em;
  }

  /* ─── DOMAINES (chips) ─────────────────────────────────────── */
  .cf-domains { background: var(--color-cream); }
  .cf-domains-frame { max-width: 1280px; margin-inline: auto; }
  .cf-domains-head { max-width: 36rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cf-domains-grid {
    list-style: none; margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 0.75rem;
  }
  .cf-domain-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem 0.625rem 0.875rem;
    border: 1px solid var(--color-hairline-on-light);
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink);
    background: var(--color-cream-2);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      background-color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-domain-chip:hover {
    border-color: var(--color-bronze);
    background: var(--color-cream);
  }
  .cf-domain-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-bronze);
    flex-shrink: 0;
  }

  /* ─── CYCLE (dark band) ────────────────────────────────────── */
  .cf-cycle {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-cycle::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 60% at 90% 10%, oklch(40% 0.06 70 / 0.22), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cf-cycle-frame { max-width: 1280px; margin-inline: auto; }
  .cf-cycle-head { max-width: 44rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cf-cycle-sub {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 36em;
  }
  .cf-cycle-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
