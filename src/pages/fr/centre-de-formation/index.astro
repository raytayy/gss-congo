---
/*
 * /fr/centre-de-formation/ — Training centre (FR).
 *
 * Lean info-only page. Inscription happens on /fr/espace-candidat/ —
 * a single CTA in the hero ("Inscrire") routes there. No form on this
 * page anymore (Web3Forms dropped, Supabase-only inscription flow).
 *
 * Structure:
 *   Hero (+ "Inscrire" CTA) → Practical (image + para) → Espace candidat (4-step journey).
 *
 * Mirror in src/pages/en/training-centre/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { educationalOrgSchema, breadcrumbSchema, courseSchema } from '@lib/jsonld';
import { contact } from '@lib/contact';

const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com/';
const trainingAddr = contact.addresses.training;
const trainingMapEmbed =
  'https://www.google.com/maps?q=5151+avenue+Kasavubu+Kalamu+Kinshasa&z=16&output=embed';

// Five training programmes (cursus) visible on the page — mirror those
// declared in educationalOrgSchema(). One Course schema is emitted per
// cursus so search engines can surface each programme individually.
const cursus = [
  {
    courseCode: 'GSS-FORMATION-AGENT',
    name: 'Agent de prévention et de sécurité',
    description: 'Tronc commun. Cadre légal, gestion d’accès, posture, communication radio, gestion de conflit.',
  },
  {
    courseCode: 'GSS-FORMATION-INCENDIE',
    name: 'Sécurité incendie & premiers secours',
    description: 'Modules type SSIAP : prévention incendie, évacuation, manipulation des extincteurs, gestes qui sauvent.',
  },
  {
    courseCode: 'GSS-FORMATION-K9',
    name: 'Cynophile & maître-chien',
    description: 'Travail en binôme avec chien d’intervention : dressage, commandement, lecture comportementale, dissuasion encadrée.',
  },
  {
    courseCode: 'GSS-FORMATION-CONDUITE',
    name: 'Conduite défensive & escorte',
    description: 'Étude d’itinéraire, anticipation, conduite sous pression, coordination en convoi, posture en cas d’incident.',
  },
  {
    courseCode: 'GSS-FORMATION-PROTOCOLE',
    name: 'Protocole & sécurité d’élite',
    description: 'Tenue civile, étiquette diplomatique, oreillette discrète, lecture de salle, déplacements VIP.',
  },
];

// Visible FAQ items (also emitted as FAQPage schema below).
const faqItems = [
  {
    q: 'Combien dure la formation ?',
    a: 'Le tronc commun « Agent de prévention et de sécurité » dure environ huit semaines, suivi de modules de spécialité (incendie, cynologie, conduite défensive, protocole) selon le cursus choisi.',
  },
  {
    q: 'Faut-il un diplôme préalable ?',
    a: 'Aucun diplôme spécifique n’est requis. Nous vérifions la maîtrise du français à l’oral, la condition physique de base, et l’absence d’antécédents incompatibles avec le métier.',
  },
  {
    q: 'Le centre forme-t-il les agents d’autres sociétés ?',
    a: 'Oui, sur demande. Le centre accueille des stagiaires d’autres sociétés de sécurité, d’ambassades et d’opérateurs privés pour des sessions calibrées sur leur besoin.',
  },
  {
    q: 'Y a-t-il une certification à l’issue de la formation ?',
    a: 'Chaque cursus se conclut par une évaluation pratique et théorique. Les agents reçoivent une attestation interne GSS, reconnue par nos clients et partenaires.',
  },
];

const jsonLd = [
  educationalOrgSchema('fr', siteUrl),
  breadcrumbSchema(
    [
      { name: 'Accueil', path: '/fr/' },
      { name: 'Centre de formation', path: '/fr/centre-de-formation/' },
    ],
    siteUrl,
  ),
  ...cursus.map((c) => courseSchema('fr', siteUrl, c.name, c.description, c.courseCode)),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'fr-CD',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="Centre de formation sécurité à Kinshasa"
  description="Centre de formation agent de sécurité à Kinshasa. Cinq cursus GSS : cadre légal, sécurité incendie, cynologie, conduite défensive, protocole VIP."
  lang="fr"
  altLocaleHref="/en/training-centre/"
  jsonLd={jsonLd}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/formation-hero.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Centre de formation</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Nos agents ne sont pas recrutés. Ils sont formés.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        Si vous êtes passionné d'avoir une carrière à long terme, rejoignez le
        centre formation de GSS. Notre nouveau centre de formation vous prépare
        pour une carrière respectueuse mais surtout sûre. Notre programme de
        formation d'agent de sécurité à Kinshasa est conçu pour vous fournir
        les compétences et les connaissances nécessaires pour devenir un agent
        qualifié et plus que compétent.
      </p>
      <div class="cf-hero-actions" data-reveal data-reveal-delay="360">
        <NeonButton variant="solid" size="lg" href="/fr/espace-candidat/">
          Inscrire
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </NeonButton>
      </div>
    </div>
  </section>

  <!-- ─── VIDÉO — showcase scroll-scrub (expansion plein écran) ──── -->
  <section class="cf-showcase" aria-labelledby="cf-video-heading" data-showcase>
    <div class="cf-showcase-sticky">
      <div class="cf-showcase-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark">En vidéo</p>
        <h2 id="cf-video-heading" class="cf-showcase-heading">
          Le centre de formation, en mouvement.
        </h2>
      </div>
      <div class="cf-showcase-media">
        <video
          controls
          playsinline
          preload="none"
          poster="/images/formation-promo-poster.jpg"
          width="640"
          height="426"
        >
          <source src="/videos/formation-promo.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <script is:inline>
    // Antigravity-style scroll-scrub: the video scales from a framed
    // card to full-viewport as the user scrolls through the section's
    // 260vh runway. Compositor-only (transform scale + opacity fade);
    // --p (0..1) drives everything from CSS. is:inline + astro:page-load
    // so it rebinds after view transitions.
    (function () {
      if (window.__gssShowcaseBound) return;
      window.__gssShowcaseBound = true;

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ticking = false;

      function update() {
        ticking = false;
        var section = document.querySelector('[data-showcase]');
        if (!section) return;
        var rect = section.getBoundingClientRect();
        var runway = rect.height - window.innerHeight;
        if (runway <= 0) return;
        var p = Math.min(1, Math.max(0, -rect.top / runway));
        section.style.setProperty('--p', p.toFixed(4));
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }


      function init() {
        if (!reduced) {
          update();
        }
      }

      if (!reduced) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>

  <!-- ─── PRACTICAL TRAINING — block 1 (image left, text right) ── -->
  <section class="cf-practical" aria-labelledby="cf-practical-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/formation-1.jpg"
          alt="Équipe GSS au complet en formation devant l'emblème de la maison — promotion du centre"
          loading="lazy"
          decoding="async"
          width="1280"
          height="853"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Pratique</p>
        <h2 id="cf-practical-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Pas seulement de la théorie.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          La formation en tant qu'agent de sécurité de GSS ne se limite pas
          qu'à la théorie. Un centre de formation de qualité vous offrira des
          opportunités d'acquérir une expérience pratique grâce à des mises
          en situation réelles. Vous serez confronté à des scénarios simulés
          où vous devrez prendre des décisions rapides, gérer des conflits
          et appliquer les procédures de sécurité appropriées. Cette expérience
          pratique vous préparera efficacement aux défis du terrain et vous
          permettra de développer votre confiance et vos compétences. Notre
          équipe d'instructeurs professionnels expérimentés vous fournira une
          formation pratique pour vous permettre de développer vos compétences
          et de vous sentir en confiance dans votre futur rôle d'agent de
          sécurité.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── CONVICTION — block 2 (image right, text left, alternating) ── -->
  <section class="cf-practical cf-practical-flip" aria-labelledby="cf-conviction-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/formation-2.jpg"
          alt="Agent GSS devant le centre de formation — façade GSS Centre de Formation de nuit"
          loading="lazy"
          decoding="async"
          width="1280"
          height="853"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Engagement</p>
        <h2 id="cf-conviction-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Votre meilleure chance.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          Chez GSS, nous sommes convaincus que notre programme de formation
          professionnelle vous donnera la meilleure chance de réussir dans
          votre carrière en tant qu'agent de sécurité. Donc n'attendez plus.
        </p>
        <div class="cf-practical-cta" data-reveal data-reveal-delay="360">
          <NeonButton variant="solid" size="lg" href="/fr/espace-candidat/">
            Inscrire
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </NeonButton>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── VISITE — adresse + carte ────────────────────────────── -->
  <section class="cf-visit" aria-labelledby="cf-visit-heading">
    <div class="cf-visit-frame">
      <div class="cf-visit-text">
        <p class="cf-eyebrow" data-reveal>Visite</p>
        <h2 id="cf-visit-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Nous trouver.
        </h2>
        <address class="cf-visit-address" data-reveal data-reveal-delay="200">
          <span class="cf-visit-line cf-visit-line-strong">{trainingAddr.street}</span>
          <span class="cf-visit-line">{trainingAddr.detail}</span>
          <span class="cf-visit-line">{trainingAddr.city}, {trainingAddr.country}</span>
        </address>
        <p class="cf-visit-cta" data-reveal data-reveal-delay="280">
          <a href={trainingAddr.mapsUrl} target="_blank" rel="noopener noreferrer">
            Itinéraire
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <div class="cf-visit-map" data-reveal data-reveal-delay="200">
        <iframe
          src={trainingMapEmbed}
          title="Centre de formation GSS — 5151, avenue Kasavubu, Kalamu, Kinshasa"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ─── FAQ — visible block ──────────────────────────────────── -->
  <section class="cf-faq" aria-labelledby="cf-faq-heading">
    <div class="cf-faq-frame">
      <p class="cf-eyebrow" data-reveal>Questions fréquentes</p>
      <h2 id="cf-faq-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
        Vos questions sur la formation.
      </h2>
      <ul class="cf-faq-list">
        {faqItems.map((item, i) => (
          <li
            class="cf-faq-item"
            data-reveal
            data-reveal-delay={String(200 + i * 80)}
            style={`--reveal-delay: ${200 + i * 80}ms;`}
          >
            <details class="cf-faq-details">
              <summary class="cf-faq-question">{item.q}</summary>
              <p class="cf-faq-answer">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  /* Mobile: portrait crop centres on the photo's white projection screen —
     shift toward the instructor and darken so cream text stays legible. */
  @media (max-width: 700px) {
    .cf-hero-image img { object-position: 64% 62%; }
    .cf-hero-overlay {
      background: linear-gradient(
        180deg,
        oklch(18% 0.03 250 / 0.34) 0%,
        oklch(14% 0.03 250 / 0.48) 55%,
        oklch(12% 0.03 250 / 0.66) 100%
      );
    }
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background: none;
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 44em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── PRACTICAL (image + paragraph) ────────────────────────── */
  .cf-practical {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-practical-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cf-practical-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
    }
  }
  .cf-practical-media {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-practical-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.94);
    animation: cf-practical-zoom 26s ease-out 0.6s forwards;
    will-change: transform;
  }
  @keyframes cf-practical-zoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-practical-tone {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 60%, oklch(15% 0.04 250 / 0.25) 100%),
      radial-gradient(60% 50% at 10% 100%, oklch(22% 0.06 70 / 0.18), transparent 65%);
    pointer-events: none;
  }
  .cf-practical-text { display: flex; flex-direction: column; }
  .cf-practical-body {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }
  .cf-practical-cta {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Alternating layout: 2nd block puts the image on the right (desktop). */
  @media (min-width: 1024px) {
    .cf-practical-flip .cf-practical-frame {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .cf-practical-flip .cf-practical-media { order: 2; }
    .cf-practical-flip .cf-practical-text { order: 1; }
  }
  /* Visual rhythm — alternate the cream background between blocks. */
  .cf-practical-flip { background: var(--color-cream-2); }

  @media (prefers-reduced-motion: reduce) {
    .cf-hero-image img,
    .cf-practical-media img { animation: none; }
  }

  /* ─── VISITE (address + embedded map) ──────────────────────── */
  .cf-visit {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-hairline-on-light);
  }
  .cf-visit-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .cf-visit-frame {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 4.5rem;
      align-items: center;
    }
  }
  .cf-visit-text { display: flex; flex-direction: column; }
  .cf-visit-address {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.55;
    color: var(--color-mute-on-light);
  }
  .cf-visit-line-strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .cf-visit-cta {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    font-size: 0.9375rem;
  }
  .cf-visit-cta a {
    color: var(--color-bronze-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline-on-light);
    padding-bottom: 0.15rem;
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cf-visit-cta a:hover {
    color: var(--color-bronze);
    border-bottom-color: var(--color-bronze);
  }
  .cf-visit-map {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-visit-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.35) saturate(0.92);
    transition: filter var(--duration-slow) var(--ease-out-expo);
  }
  .cf-visit-map:hover iframe { filter: grayscale(0) saturate(1); }

  /* ─── Hero CTA ─────────────────────────────────────────────── */
  .cf-hero-actions {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* ─── FAQ ──────────────────────────────────────────────────── */
  .cf-faq {
    background: var(--color-cream-2);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
