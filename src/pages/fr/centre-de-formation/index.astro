---
/*
 * /fr/centre-de-formation/ — Training centre (FR).
 *
 * Lean info-only page. Inscription happens on /fr/espace-candidat/ —
 * a single CTA in the hero ("Inscrire") routes there. No form on this
 * page anymore (Web3Forms dropped, Supabase-only inscription flow).
 *
 * Structure:
 *   Hero (+ "Inscrire" CTA) → Practical (image + para) → Espace candidat (4-step journey).
 *
 * Mirror in src/pages/en/training-centre/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { educationalOrgSchema } from '@lib/jsonld';

const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com/';

const candidateJourney = [
  {
    n: '01',
    title: 'Dossier',
    meta: 'Réponse sous 7 jours ouvrés',
    body: "Envoyez votre CV, lettre de motivation, disponibilité et zone de Kinshasa souhaitée. Nous accusons réception immédiatement, et revenons vers vous avec une suite — entretien planifié ou intégration au vivier de la prochaine cohorte.",
  },
  {
    n: '02',
    title: 'Entretien',
    meta: 'Au siège, à Gombe',
    body: "Rendez-vous au siège pour un entretien individuel. Vérification d'identité, validation de motivation, test physique de base. Comptez 1h30 sur place. Pas de stress — c'est aussi une conversation pour qu'on apprenne à se connaître.",
  },
  {
    n: '03',
    title: 'Formation',
    meta: 'Sur invitation de cohorte',
    body: "Intégration à la prochaine promotion. Théorie, pratique, mises en situation, évaluation finale. Aucun passage automatique : chaque module se valide, certains se reprennent à la session suivante si nécessaire.",
  },
  {
    n: '04',
    title: 'Affectation',
    meta: 'Première mission accompagnée',
    body: "Mise en service sur votre premier site avec un référent terrain à vos côtés la première semaine. Évaluation à 30 jours, contrat consolidé. À partir de ce moment, la maison commence à investir dans votre durée.",
  },
];
---

<BaseLayout
  title="Centre de formation"
  description="Le centre de formation GSS forme nos agents et, sur demande, ceux d’autres maisons. Cadre légal, sécurité incendie, cynologie, conduite défensive, protocole."
  lang="fr"
  altLocaleHref="/en/training-centre/"
  jsonLd={educationalOrgSchema('fr', siteUrl)}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/careers-graphique.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Centre de formation</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Nos agents ne sont pas recrutés. Ils sont formés.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        Si vous êtes passionné d'avoir une carrière à long terme, rejoignez le
        centre formation de GSS. Notre nouveau centre de formation vous prépare
        pour une carrière respectueuse mais surtout sûre. Notre programme de
        formation professionnelle est conçu pour vous fournir les compétences
        et les connaissances nécessaires pour devenir un agent de sécurité
        qualifié et plus que compétent.
      </p>
      <div class="cf-hero-actions" data-reveal data-reveal-delay="360">
        <NeonButton variant="solid" size="lg" href="/fr/espace-candidat/">
          Inscrire
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </NeonButton>
      </div>
    </div>
  </section>

  <!-- ─── PRACTICAL TRAINING (image + paragraph, side by side) ──── -->
  <section class="cf-practical" aria-labelledby="cf-practical-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/practical-training.jpg"
          alt="Agents GSS en mise en situation pratique — coordination et mouvement dans la cour du centre de formation"
          loading="lazy"
          decoding="async"
          width="900"
          height="1000"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Pratique</p>
        <h2 id="cf-practical-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Pas seulement de la théorie.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          La formation en tant qu'agent de sécurité de GSS ne se limite pas
          qu'à la théorie. Un centre de formation de qualité vous offrira des
          opportunités d'acquérir une expérience pratique grâce à des mises
          en situation réelles. Vous serez confronté à des scénarios simulés
          où vous devrez prendre des décisions rapides, gérer des conflits
          et appliquer les procédures de sécurité appropriées. Cette expérience
          pratique vous préparera efficacement aux défis du terrain et vous
          permettra de développer votre confiance et vos compétences.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── ESPACE CANDIDAT (4-step journey) ────────────────────── -->
  <section class="cf-candidate" aria-labelledby="cf-candidate-heading">
    <div class="cf-candidate-frame">
      <header class="cf-candidate-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Espace candidat</p>
        <h2 id="cf-candidate-heading" class="cf-section-heading cf-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Votre parcours, en 4 étapes.
        </h2>
        <p class="cf-candidate-sub" data-reveal data-reveal-delay="200">
          De l'envoi de votre dossier à votre première affectation,
          voici exactement ce qui vous attend. Aucune zone grise.
        </p>
      </header>
      <ol class="cf-candidate-steps">
        {candidateJourney.map((step, i) => (
          <li
            class="cf-candidate-step"
            data-reveal
            data-reveal-delay={String(180 + i * 100)}
            style={`--reveal-delay: ${180 + i * 100}ms;`}
          >
            <div class="cf-candidate-step-head">
              <span class="cf-candidate-num">{step.n}</span>
              <span class="cf-candidate-meta">{step.meta}</span>
            </div>
            <h3 class="cf-candidate-step-title">{step.title}</h3>
            <p class="cf-candidate-step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 44em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── PRACTICAL (image + paragraph) ────────────────────────── */
  .cf-practical {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-practical-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cf-practical-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
    }
  }
  .cf-practical-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-practical-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.94);
    animation: cf-practical-zoom 26s ease-out 0.6s forwards;
    will-change: transform;
  }
  @keyframes cf-practical-zoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-practical-tone {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 60%, oklch(15% 0.04 250 / 0.25) 100%),
      radial-gradient(60% 50% at 10% 100%, oklch(22% 0.06 70 / 0.18), transparent 65%);
    pointer-events: none;
  }
  .cf-practical-text { display: flex; flex-direction: column; }
  .cf-practical-body {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-hero-image img,
    .cf-practical-media img { animation: none; }
  }

  /* ─── ESPACE CANDIDAT ──────────────────────────────────────── */
  .cf-candidate {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-candidate::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(70% 50% at 100% 0%, oklch(40% 0.06 70 / 0.20), transparent 70%),
      radial-gradient(60% 50% at 0% 100%, oklch(40% 0.06 70 / 0.16), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cf-candidate-frame { max-width: 1280px; margin-inline: auto; }
  .cf-candidate-head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cf-candidate-sub {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 36em;
  }
  .cf-candidate-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) {
    .cf-candidate-steps { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cf-candidate-steps { grid-template-columns: repeat(2, 1fr); }
  }
  .cf-candidate-step {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background-color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-candidate-step:hover { background: oklch(100% 0 0 / 0.02); }
  @media (min-width: 1024px) {
    .cf-candidate-step { border-bottom: none; }
    .cf-candidate-step:last-child { border-right: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cf-candidate-step:nth-child(2n) { border-right: none; }
    .cf-candidate-step:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .cf-candidate-step { border-right: none; }
    .cf-candidate-step:last-child { border-bottom: none; }
  }
  .cf-candidate-step-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .cf-candidate-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 460;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    line-height: 1;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .cf-candidate-meta {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-warm);
    opacity: 0.78;
    text-align: right;
    max-width: 11em;
    line-height: 1.4;
  }
  .cf-candidate-step-title {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.1;
    color: var(--color-cream);
    letter-spacing: -0.015em;
  }
  .cf-candidate-step-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.82;
    max-width: 22em;
  }

  /* ─── Hero CTA ─────────────────────────────────────────────── */
  .cf-hero-actions {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
</style>
