---
/*
 * /fr/centre-de-formation/ — Training centre (FR).
 *
 * Lean structure after 2026-05-17 rewrite:
 *   Hero → Practical (image + para) → Espace candidat (4-step journey) → Inscription form.
 *
 * The 5 cursus + curriculum + 4-step cycle sections were removed (client
 * call — "irrelevant blabering"). The JSON-LD `educationalOrgSchema` still
 * lists the 5 programmes via OfferCatalog because the entity DOES offer
 * them — the page just no longer editorializes about each one.
 *
 * Mirror in src/pages/en/training-centre/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';
import { educationalOrgSchema } from '@lib/jsonld';

const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com/';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const candidateJourney = [
  {
    n: '01',
    title: 'Dossier',
    meta: 'Réponse sous 7 jours ouvrés',
    body: "Envoyez votre CV, lettre de motivation, disponibilité et zone de Kinshasa souhaitée. Nous accusons réception immédiatement, et revenons vers vous avec une suite — entretien planifié ou intégration au vivier de la prochaine cohorte.",
  },
  {
    n: '02',
    title: 'Entretien',
    meta: 'Au siège, à Gombe',
    body: "Rendez-vous au siège pour un entretien individuel. Vérification d'identité, validation de motivation, test physique de base. Comptez 1h30 sur place. Pas de stress — c'est aussi une conversation pour qu'on apprenne à se connaître.",
  },
  {
    n: '03',
    title: 'Formation',
    meta: 'Sur invitation de cohorte',
    body: "Intégration à la prochaine promotion. Théorie, pratique, mises en situation, évaluation finale. Aucun passage automatique : chaque module se valide, certains se reprennent à la session suivante si nécessaire.",
  },
  {
    n: '04',
    title: 'Affectation',
    meta: 'Première mission accompagnée',
    body: "Mise en service sur votre premier site avec un référent terrain à vos côtés la première semaine. Évaluation à 30 jours, contrat consolidé. À partir de ce moment, la maison commence à investir dans votre durée.",
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
---

<BaseLayout
  title="Centre de formation"
  description="Le centre de formation GSS forme nos agents et, sur demande, ceux d’autres maisons. Cadre légal, sécurité incendie, cynologie, conduite défensive, protocole."
  lang="fr"
  altLocaleHref="/en/training-centre/"
  jsonLd={educationalOrgSchema('fr', siteUrl)}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/careers-graphique.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Centre de formation</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Nos agents ne sont pas recrutés. Ils sont formés.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        Si vous êtes passionné d'avoir une carrière à long terme, rejoignez le
        centre formation de GSS. Notre nouveau centre de formation vous prépare
        pour une carrière respectueuse mais surtout sûre. Notre programme de
        formation professionnelle est conçu pour vous fournir les compétences
        et les connaissances nécessaires pour devenir un agent de sécurité
        qualifié et plus que compétent.
      </p>
    </div>
  </section>

  <!-- ─── PRACTICAL TRAINING (image + paragraph, side by side) ──── -->
  <section class="cf-practical" aria-labelledby="cf-practical-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/practical-training.jpg"
          alt="Agents GSS en mise en situation pratique — coordination et mouvement dans la cour du centre de formation"
          loading="lazy"
          decoding="async"
          width="900"
          height="1000"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Pratique</p>
        <h2 id="cf-practical-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Pas seulement de la théorie.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          La formation en tant qu'agent de sécurité de GSS ne se limite pas
          qu'à la théorie. Un centre de formation de qualité vous offrira des
          opportunités d'acquérir une expérience pratique grâce à des mises
          en situation réelles. Vous serez confronté à des scénarios simulés
          où vous devrez prendre des décisions rapides, gérer des conflits
          et appliquer les procédures de sécurité appropriées. Cette expérience
          pratique vous préparera efficacement aux défis du terrain et vous
          permettra de développer votre confiance et vos compétences.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── ESPACE CANDIDAT (4-step journey) ────────────────────── -->
  <section class="cf-candidate" aria-labelledby="cf-candidate-heading">
    <div class="cf-candidate-frame">
      <header class="cf-candidate-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Espace candidat</p>
        <h2 id="cf-candidate-heading" class="cf-section-heading cf-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Votre parcours, en 4 étapes.
        </h2>
        <p class="cf-candidate-sub" data-reveal data-reveal-delay="200">
          De l'envoi de votre dossier à votre première affectation,
          voici exactement ce qui vous attend. Aucune zone grise.
        </p>
      </header>
      <ol class="cf-candidate-steps">
        {candidateJourney.map((step, i) => (
          <li
            class="cf-candidate-step"
            data-reveal
            data-reveal-delay={String(180 + i * 100)}
            style={`--reveal-delay: ${180 + i * 100}ms;`}
          >
            <div class="cf-candidate-step-head">
              <span class="cf-candidate-num">{step.n}</span>
              <span class="cf-candidate-meta">{step.meta}</span>
            </div>
            <h3 class="cf-candidate-step-title">{step.title}</h3>
            <p class="cf-candidate-step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── INSCRIPTION (form) ──────────────────────────────────── -->
  <section class="cf-cta" aria-labelledby="cf-cta-heading">
    <div class="cf-cta-frame">
      <div class="cf-cta-text" data-reveal>
        <p class="cf-eyebrow">Inscription</p>
        <h2 id="cf-cta-heading" class="cf-cta-heading">
          Postuler, ou inscrire vos équipes.
        </h2>
        <p class="cf-cta-sub">
          Candidats individuels, RH d'entreprise, postes de sécurité diplomatique.
          Calendriers de promotions ou formation dédiée sur demande.
        </p>
        <p class="cf-cta-phone">
          Ou appelez-nous,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.fr}</span>
        </p>
        <p class="cf-cta-wa">
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cf-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cf-notice" role="status">
            <strong>Formulaire en attente de configuration.</strong>
            En attendant, WhatsApp et téléphone restent ouverts.
          </p>
        )}

        <form
          class="cf-form"
          data-candidate-form
          data-locale="fr"
          data-merci-path="/fr/merci/"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/fr/merci/`} />
          <input type="hidden" name="from_name" value="GSS Congo — inscription formation" />
          <input type="hidden" name="subject" value="Nouvelle inscription formation depuis gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Nom complet *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Téléphone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Entreprise (le cas échéant)</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Type d'inscription</span>
              <select name="type">
                <option value="individuel">Individuel</option>
                <option value="equipe">Équipe (RH d'entreprise)</option>
                <option value="diplomatique">Poste de sécurité diplomatique</option>
              </select>
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Quelques mots sur votre contexte</span>
            <textarea name="message" rows="4" placeholder="Disponibilité, effectif à former, contraintes…"></textarea>
          </label>

          <p class="cf-fineprint">
            Vos informations restent confidentielles et ne sont utilisées
            que pour le traitement de votre inscription.
          </p>

          <div class="cf-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Envoyer mon inscription
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Intercept the inscription form: create a Supabase candidate row,
  // append the reference + redirect URL, then let Web3Forms continue
  // its native POST so Bechir still receives the email notification.
  //
  // is:inline is NOT used here — we need the `submit` helper from
  // @lib/candidate, which only works through Astro's bundler. So we
  // re-attach the listener on every `astro:page-load` to survive
  // view transitions (the form element is replaced after swap).
  import { submit, rememberCandidate, isConfigured } from '@lib/candidate';

  function setupCandidateForm(): void {
    const form = document.querySelector<HTMLFormElement>('[data-candidate-form]');
    if (!form || form.dataset.candidateBound === '1') return;
    form.dataset.candidateBound = '1';

    form.addEventListener('submit', async (e) => {
      if (!isConfigured()) return; // fall through to Web3Forms only
      e.preventDefault();

      const fd = new FormData(form);
      const email = String(fd.get('email') ?? '').trim();
      const locale = (form.dataset.locale === 'en' ? 'en' : 'fr') as 'fr' | 'en';
      const merciPath = form.dataset.merciPath ?? '/fr/merci/';
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      try {
        const result = await submit({
          email,
          full_name: String(fd.get('name') ?? '').trim(),
          phone: String(fd.get('phone') ?? '').trim(),
          type: (String(fd.get('type') ?? 'individuel') as 'individuel' | 'equipe' | 'diplomatique'),
          company: String(fd.get('company') ?? '').trim() || undefined,
          message: String(fd.get('message') ?? '').trim() || undefined,
          locale,
        });

        if ('reference' in result) {
          // Append reference to the form so Web3Forms includes it in the email.
          const refInput = document.createElement('input');
          refInput.type = 'hidden';
          refInput.name = 'reference';
          refInput.value = result.reference;
          form.appendChild(refInput);

          rememberCandidate(result.reference, email);

          // Update redirect URL with ref so the merci page can display it.
          const redirectInput = form.querySelector<HTMLInputElement>('input[name="redirect"]');
          if (redirectInput) {
            const base = location.origin + merciPath;
            redirectInput.value = `${base}?ref=${encodeURIComponent(result.reference)}`;
          }
        } else {
          // Supabase insert failed — log but still submit to Web3Forms so
          // we don't lose the lead. Bechir will see the email.
          console.warn('[candidate] Supabase insert failed:', result.error);
        }
      } catch (err) {
        console.warn('[candidate] interception error:', err);
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        form.submit();
      }
    });
  }

  document.addEventListener('astro:page-load', setupCandidateForm);
</script>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 44em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── PRACTICAL (image + paragraph) ────────────────────────── */
  .cf-practical {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-practical-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cf-practical-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
    }
  }
  .cf-practical-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-practical-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.94);
    animation: cf-practical-zoom 26s ease-out 0.6s forwards;
    will-change: transform;
  }
  @keyframes cf-practical-zoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-practical-tone {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 60%, oklch(15% 0.04 250 / 0.25) 100%),
      radial-gradient(60% 50% at 10% 100%, oklch(22% 0.06 70 / 0.18), transparent 65%);
    pointer-events: none;
  }
  .cf-practical-text { display: flex; flex-direction: column; }
  .cf-practical-body {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-hero-image img,
    .cf-practical-media img { animation: none; }
  }

  /* ─── ESPACE CANDIDAT ──────────────────────────────────────── */
  .cf-candidate {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-candidate::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(70% 50% at 100% 0%, oklch(40% 0.06 70 / 0.20), transparent 70%),
      radial-gradient(60% 50% at 0% 100%, oklch(40% 0.06 70 / 0.16), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cf-candidate-frame { max-width: 1280px; margin-inline: auto; }
  .cf-candidate-head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cf-candidate-sub {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 36em;
  }
  .cf-candidate-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) {
    .cf-candidate-steps { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cf-candidate-steps { grid-template-columns: repeat(2, 1fr); }
  }
  .cf-candidate-step {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background-color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-candidate-step:hover { background: oklch(100% 0 0 / 0.02); }
  @media (min-width: 1024px) {
    .cf-candidate-step { border-bottom: none; }
    .cf-candidate-step:last-child { border-right: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cf-candidate-step:nth-child(2n) { border-right: none; }
    .cf-candidate-step:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .cf-candidate-step { border-right: none; }
    .cf-candidate-step:last-child { border-bottom: none; }
  }
  .cf-candidate-step-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .cf-candidate-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 460;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    line-height: 1;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .cf-candidate-meta {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-warm);
    opacity: 0.78;
    text-align: right;
    max-width: 11em;
    line-height: 1.4;
  }
  .cf-candidate-step-title {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.1;
    color: var(--color-cream);
    letter-spacing: -0.015em;
  }
  .cf-candidate-step-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.82;
    max-width: 22em;
  }

  /* ─── CTA (inscription form, cream) ────────────────────────── */
  .cf-cta {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 12vw, 11rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-cta-frame {
    position: relative;
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: end;
