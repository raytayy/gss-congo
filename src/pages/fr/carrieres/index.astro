---
/*
 * /fr/carrieres/ — Careers (FR).
 * Persona: P5 (recruit funnel). Honest framing: no fake live openings —
 * we recruit by cohort in lockstep with the training centre. Beats:
 * Hero → Manifeste → Pourquoi → Métiers → Profil → Postuler → CTA.
 * Mirror in src/pages/en/careers/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const principles = [
  {
    n: '01',
    title: 'Formé avant d’être déployé.',
    body: 'Personne n’entre en mission sans avoir suivi notre cycle de formation. Pas d’improvisation sur le terrain.',
  },
  {
    n: '02',
    title: 'Encadrement opérationnel.',
    body: 'Chaque agent a un référent, une chaîne de commandement claire, et un retour terrain régulier. On corrige ce qui doit l’être.',
  },
  {
    n: '03',
    title: 'Une perspective, pas seulement un poste.',
    body: 'Évolution vers chef de poste, instructeur, opérateur supervision. Les meilleurs profils accèdent aux missions VIP et escorte.',
  },
];

const roles = [
  {
    name: 'Agent de prévention et de sécurité',
    body: 'Le tronc commun. Présence statique, contrôle d’accès, patrouille périmétrique, communication radio.',
  },
  {
    name: 'Chef de poste',
    body: 'Coordination d’une équipe sur site, supervision des relèves, interface avec le client, reporting incidents.',
  },
  {
    name: 'Maître-chien & cynophile',
    body: 'Travail en binôme avec un chien d’intervention. Formation continue, soin et conditionnement de l’animal.',
  },
  {
    name: 'Chauffeur d’escorte',
    body: 'Conduite défensive certifiée, étude d’itinéraire, coordination convoi, posture en cas d’incident.',
  },
  {
    name: 'Agent de sécurité d’élite',
    body: 'Tenue civile, protocole, accompagnement VIP. Profils sélectionnés après plusieurs années en gardiennage.',
  },
  {
    name: 'Opérateur centre de supervision',
    body: 'Veille caméras 24/7, levée de doute, déclenchement intervention, rapports d’activité quotidiens.',
  },
];

const profile = [
  'Intégrité. Vérification d’antécédents systématique.',
  'Rigueur. Ponctualité, présentation, respect des procédures.',
  'Condition physique. Test à l’entrée, entretien continu.',
  'Sang-froid. Formation à la gestion de conflit, mises en situation.',
  'Discrétion. Ce que vous voyez sur site reste sur site.',
];

const steps = [
  {
    n: '01',
    title: 'Dossier',
    body: 'Envoyez CV + lettre de motivation. Précisez disponibilité et zone de Kinshasa souhaitée.',
  },
  {
    n: '02',
    title: 'Entretien',
    body: 'Rendez-vous au siège. Vérification d’identité, motivation, expérience éventuelle.',
  },
  {
    n: '03',
    title: 'Formation',
    body: 'Intégration à une promotion du centre — théorie, pratique, évaluation.',
  },
  {
    n: '04',
    title: 'Affectation',
    body: 'Première mission accompagnée d’un référent. Évaluation à 30 jours, contrat consolidé.',
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
const careersWaMessage = 'Bonjour GSS, je vous contacte depuis votre site internet. Je souhaite postuler — voici mon profil…';
---

<BaseLayout
  title="Carrières"
  description="Rejoindre GSS Congo : agents de prévention, chefs de poste, maîtres-chiens, chauffeurs d’escorte, sécurité d’élite, supervision. Recrutement par cohorts."
  lang="fr"
  altLocaleHref="/en/careers/"
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cr-hero" aria-labelledby="cr-heading">
    <div class="cr-hero-image" aria-hidden="true">
      <img src="/images/banner1.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cr-hero-overlay"></div>
    </div>
    <div class="cr-hero-content">
      <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>Carrières</p>
      <h1 id="cr-heading" class="cr-hero-title" data-reveal data-reveal-delay="120">
        La discipline. Et un avenir.
      </h1>
      <p class="cr-hero-intro" data-reveal data-reveal-delay="240">
        Nous recrutons par cohortes, en lien direct avec notre centre de
        formation. Pas d’offres affichées en permanence — un dossier reçu
        rejoint le vivier et trouve sa promotion. La maison forme, déploie,
        suit, et fait progresser.
      </p>
    </div>
  </section>

  <!-- ─── MANIFESTE ───────────────────────────────────────────── -->
  <section class="cr-section cr-manifest" aria-labelledby="cr-manifest-heading">
    <div class="cr-manifest-frame">
      <p class="cr-eyebrow" data-reveal>Manifeste</p>
      <p id="cr-manifest-heading" class="cr-manifest-text" data-reveal data-reveal-delay="120">
        Servir comme agent ne s’improvise pas. Cela s’apprend, se vérifie,
        et se renouvelle. Nous cherchons des gens prêts à entrer dans cette
        discipline — et à y rester.
      </p>
    </div>
  </section>

  <!-- ─── POURQUOI (dark band) ────────────────────────────────── -->
  <section class="cr-section cr-why" aria-labelledby="cr-why-heading">
    <div class="cr-why-frame">
      <div class="cr-why-head">
        <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>Pourquoi rejoindre</p>
        <h2 id="cr-why-heading" class="cr-section-heading cr-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Trois engagements, à l’égard de chaque agent.
        </h2>
      </div>
      <ol class="cr-why-grid">
        {principles.map((p, i) => (
          <li
            class="cr-why-item"
            data-reveal
            data-reveal-delay={String(150 + i * 120)}
            style={`--reveal-delay: ${150 + i * 120}ms;`}
          >
            <span class="cr-why-num">{p.n}</span>
            <h3 class="cr-why-title">{p.title}</h3>
            <p class="cr-why-body">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── MÉTIERS ─────────────────────────────────────────────── -->
  <section class="cr-section cr-roles" aria-labelledby="cr-roles-heading">
    <div class="cr-roles-frame">
      <div class="cr-roles-head">
        <p class="cr-eyebrow" data-reveal>Métiers</p>
        <h2 id="cr-roles-heading" class="cr-section-heading" data-reveal data-reveal-delay="100">
          Six métiers de la maison.
        </h2>
        <p class="cr-roles-sub" data-reveal data-reveal-delay="200">
          Les rôles ouverts en continu, par cohorts. La passerelle entre
          chaque métier passe par la formation interne.
        </p>
      </div>
      <ol class="cr-roles-list">
        {roles.map((r, i) => (
          <li
            class="cr-role"
            data-reveal
            data-reveal-delay={String(150 + i * 90)}
            style={`--reveal-delay: ${150 + i * 90}ms;`}
          >
            <span class="cr-role-num" aria-hidden="true">/ {String(i + 1).padStart(2, '0')}</span>
            <div class="cr-role-text">
              <h3 class="cr-role-name">{r.name}</h3>
              <p class="cr-role-body">{r.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── PROFIL ──────────────────────────────────────────────── -->
  <section class="cr-section cr-profile" aria-labelledby="cr-profile-heading">
    <div class="cr-profile-frame">
      <div class="cr-profile-head">
        <p class="cr-eyebrow" data-reveal>Profil recherché</p>
        <h2 id="cr-profile-heading" class="cr-section-heading" data-reveal data-reveal-delay="100">
          Cinq qualités. Pas négociables.
        </h2>
      </div>
      <ul class="cr-profile-list" aria-label="Cinq qualités attendues">
        {profile.map((p, i) => (
          <li
            class="cr-profile-item"
            data-reveal
            data-reveal-delay={String(150 + i * 80)}
            style={`--reveal-delay: ${150 + i * 80}ms;`}
          >
            <span class="cr-profile-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cr-profile-text">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── COMMENT POSTULER (dark band) ────────────────────────── -->
  <section class="cr-section cr-apply" aria-labelledby="cr-apply-heading">
    <div class="cr-apply-frame">
      <div class="cr-apply-head">
        <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>Comment postuler</p>
        <h2 id="cr-apply-heading" class="cr-section-heading cr-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Quatre étapes, et c’est concret.
        </h2>
      </div>
      <ol class="cr-apply-grid">
        {steps.map((s, i) => (
          <li
            class="cr-apply-step"
            data-reveal
            data-reveal-delay={String(150 + i * 100)}
            style={`--reveal-delay: ${150 + i * 100}ms;`}
          >
            <span class="cr-apply-num">{s.n}</span>
            <h3 class="cr-apply-title">{s.title}</h3>
            <p class="cr-apply-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── CANDIDATURE (form with CV upload) ───────────────────── -->
  <section class="cr-cta" aria-labelledby="cr-cta-heading">
    <div class="cr-cta-frame">
      <div class="cr-cta-text" data-reveal>
        <p class="cr-eyebrow cr-eyebrow-on-dark">Candidature</p>
        <h2 id="cr-cta-heading" class="cr-cta-heading">
          Envoyez votre dossier.
        </h2>
        <p class="cr-cta-sub">
          CV + lettre de motivation. Disponibilité, zone souhaitée, expérience
          éventuelle. Nous revenons sous 7 jours ouvrés pour caler un entretien
          ou vous indiquer la prochaine cohorte.
        </p>
        <p class="cr-cta-phone">
          Ou appelez-nous,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.fr}</span>
        </p>
        <p class="cr-cta-wa">
          <a href={whatsappLink(careersWaMessage)} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cr-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cr-notice" role="status">
            <strong>Formulaire en attente de configuration.</strong>
            En attendant, WhatsApp et téléphone restent ouverts.
          </p>
        )}

        <form
          class="cr-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          enctype="multipart/form-data"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/fr/merci/`} />
          <input type="hidden" name="from_name" value="GSS Congo — candidature" />
          <input type="hidden" name="subject" value="Nouvelle candidature depuis gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cr-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cr-row">
            <label class="cr-field">
              <span class="cr-label">Nom complet *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cr-field">
              <span class="cr-label">Téléphone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cr-field">
            <span class="cr-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label class="cr-field">
            <span class="cr-label">Poste souhaité</span>
            <select name="role">
              <option value="">— Choisir un poste —</option>
              {roles.map((r) => (
                <option value={r.name}>{r.name}</option>
              ))}
              <option value="autre">Autre / à discuter</option>
            </select>
          </label>

          <div class="cr-row">
            <label class="cr-field">
              <span class="cr-label">Zone Kinshasa souhaitée</span>
              <input type="text" name="zone" placeholder="Gombe, Limete, Lemba…" />
            </label>
            <label class="cr-field">
              <span class="cr-label">Disponibilité</span>
              <input type="text" name="availability" placeholder="Immédiate, 1 mois, etc." />
            </label>
          </div>

          <label class="cr-field">
            <span class="cr-label">CV (PDF ou Word, 5 Mo max)</span>
            <input
              type="file"
              name="cv"
              accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            />
          </label>

          <label class="cr-field">
            <span class="cr-label">Quelques mots sur votre motivation</span>
            <textarea name="message" rows="4" placeholder="Expérience, intérêt, contexte personnel…"></textarea>
          </label>

          <p class="cr-fineprint">
            Vos informations restent confidentielles et ne sont utilisées
            que pour le traitement de votre candidature.
          </p>

          <div class="cr-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Envoyer ma candidature
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cr-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cr-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cr-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.88);
    animation: cr-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cr-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cr-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cr-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cr-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 14em;
    text-wrap: balance;
  }
  .cr-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 40em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cr-section {
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cr-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cr-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cr-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cr-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cr-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cr-section-heading-on-dark { color: var(--color-cream); }

  /* ─── MANIFESTE ────────────────────────────────────────────── */
  .cr-manifest {
    background: var(--color-cream);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .cr-manifest-frame { max-width: 920px; margin-inline: auto; }
  .cr-manifest-text {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 420, 'SOFT' 40;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* ─── POURQUOI (dark band) ─────────────────────────────────── */
  .cr-why {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cr-why::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 60% at 90% 10%, oklch(40% 0.06 70 / 0.22), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cr-why-frame { max-width: 1280px; margin-inline: auto; }
  .cr-why-head { max-width: 44rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cr-why-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) { .cr-why-grid { grid-template-columns: repeat(3, 1fr); } }
  .cr-why-item {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) {
    .cr-why-item { border-bottom: none; }
    .cr-why-item:last-child { border-right: none; }
  }
  @media (max-width: 1023px) {
    .cr-why-item:last-child { border-bottom: none; border-right: none; }
  }
  .cr-why-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.875rem;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }
  .cr-why-title {
    margin: 1rem 0 0.875rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.15;
    color: var(--color-cream);
    letter-spacing: -0.015em;
    max-width: 16em;
    text-wrap: balance;
  }
  .cr-why-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 28em;
  }

  /* ─── MÉTIERS ──────────────────────────────────────────────── */
  .cr-roles { background: var(--color-cream); }
  .cr-roles-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 1024px) {
    .cr-roles-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: start;
    }
  }
  .cr-roles-head { max-width: 30rem; }
  .cr-roles-sub {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
  }
  .cr-roles-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .cr-role {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-hairline-on-light);
    align-items: baseline;
  }
  .cr-role:last-child { border-bottom: 1px solid var(--color-hairline-on-light); }
  .cr-role-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.9375rem;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    padding-top: 0.25rem;
  }
  .cr-role-text { display: flex; flex-direction: column; gap: 0.5rem; }
  .cr-role-name {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .cr-role-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 38em;
  }

  /* ─── PROFIL ───────────────────────────────────────────────── */
  .cr-profile { background: var(--color-cream-2); }
  .cr-profile-frame { max-width: 1280px; margin-inline: auto; }
  .cr-profile-head { max-width: 36rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cr-profile-list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-hairline-on-light);
  }
  @media (min-width: 1024px) {
    .cr-profile-list { grid-template-columns: repeat(5, 1fr); }
  }
  .cr-profile-item {
