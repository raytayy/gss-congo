---
/*
 * /fr/actualites/ — News hub (FR).
 * Editorial cards for each Article in src/lib/news.ts.
 * Mirror in src/pages/en/news/index.astro.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import { articles, getArticleUrl, newsLabels } from '@lib/news';
---

<BaseLayout
  title="Actualités"
  description="Notes éditoriales GSS Congo — sécurité privée à Kinshasa, formation, posture diplomatique."
  lang="fr"
  altLocaleHref="/en/news/"
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="nh-hero" aria-labelledby="nh-heading">
    <div class="nh-hero-frame">
      <p class="nh-eyebrow" data-reveal>{newsLabels.hubEyebrow.fr}</p>
      <h1 id="nh-heading" class="nh-hero-title" data-reveal data-reveal-delay="120">
        {newsLabels.hubHeading.fr}
      </h1>
      <p class="nh-hero-sub" data-reveal data-reveal-delay="240">
        {newsLabels.hubSub.fr}
      </p>
    </div>
  </section>

  <!-- ─── ARTICLE GRID ────────────────────────────────────────── -->
  <section class="nh-grid-section" aria-label="Liste des articles">
    <ul class="nh-grid">
      {articles.map((a, i) => (
        <li
          class="nh-card"
          data-reveal
          data-reveal-delay={String(150 + i * 120)}
          style={`--reveal-delay: ${150 + i * 120}ms;`}
        >
          <a class="nh-card-link" href={getArticleUrl(a, 'fr')}>
            <div class="nh-card-media">
              <img src={a.image} alt="" loading="lazy" decoding="async" />
              <div class="nh-card-tone" aria-hidden="true"></div>
            </div>
            <div class="nh-card-body">
              <p class="nh-card-meta">
                <time datetime={a.publishedAt}>{a.publishedAt}</time>
                <span aria-hidden="true">·</span>
                <span>{a.readingTime.fr}</span>
              </p>
              <h2 class="nh-card-title">{a.title.fr}</h2>
              <p class="nh-card-excerpt">{a.excerpt.fr}</p>
              <span class="nh-card-cue">
                {newsLabels.readMore.fr}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .nh-hero {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(7rem, 14vw, 12rem) clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4rem);
  }
  .nh-hero-frame { max-width: 1280px; margin-inline: auto; }
  .nh-eyebrow {
    margin: 0 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .nh-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .nh-hero-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6vw, 5.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .nh-hero-sub {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 38em;
  }

  .nh-grid-section {
    background: var(--color-cream);
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 5vw, 4rem) clamp(6rem, 12vw, 11rem);
  }
  .nh-grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1280px;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 768px) { .nh-grid { grid-template-columns: repeat(3, 1fr); } }

  .nh-card { list-style: none; }
  .nh-card-link {
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    color: inherit;
    background: var(--color-cream-2);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
    height: 100%;
  }
  .nh-card-link:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 18px 40px -16px oklch(20% 0.04 250 / 0.20);
  }
  .nh-card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .nh-card-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition: transform var(--duration-slow) var(--ease-out-expo);
  }
  .nh-card-link:hover .nh-card-media img { transform: scale(1.05); }
  .nh-card-tone {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 55%, oklch(8% 0.03 250 / 0.40) 100%);
    pointer-events: none;
  }
  .nh-card-body {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .nh-card-meta {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;
  }
  .nh-card-meta time { color: var(--color-bronze-deep); }
  .nh-card-meta span[aria-hidden] { color: var(--color-bronze); opacity: 0.7; }
  .nh-card-title {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .nh-card-excerpt {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-mute-on-light);
  }
  .nh-card-cue {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
  }
  .nh-card-cue svg {
    width: 0.875rem;
    height: 0.875rem;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }
  .nh-card-link:hover .nh-card-cue svg { transform: translateX(0.25rem); }
</style>
