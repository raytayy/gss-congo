---
/*
 * /en/careers/ — Careers (EN). Mirror of /fr/carrieres/index.astro.
 * Beats: Hero → Manifesto → Why → Roles → Profile → How to apply → CTA.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const principles = [
  {
    n: '01',
    title: 'Trained before deployed.',
    body: 'No agent enters a mission without completing our training cycle. No improvisation in the field.',
  },
  {
    n: '02',
    title: 'Operational supervision.',
    body: 'Every agent has a mentor, a clear chain of command, and regular field feedback. We correct what should be corrected.',
  },
  {
    n: '03',
    title: 'A path, not just a post.',
    body: 'Progression to post chief, instructor, supervision operator. The strongest profiles move into VIP and escort missions.',
  },
];

const roles = [
  {
    name: 'Prevention & security agent',
    body: 'The common core. Static presence, access control, perimeter patrol, radio communication.',
  },
  {
    name: 'Post chief',
    body: 'Coordinating a site team, managing rotations, client interface, incident reporting.',
  },
  {
    name: 'Canine handler & K9',
    body: 'Two-handler work with response dogs. Continuous training, animal care and conditioning.',
  },
  {
    name: 'Escort driver',
    body: 'Certified defensive driving, route study, convoy coordination, posture under incident.',
  },
  {
    name: 'Elite security agent',
    body: 'Civilian dress, protocol, VIP escort. Profiles selected after several years in standard guarding.',
  },
  {
    name: 'Supervision centre operator',
    body: '24/7 camera watch, doubt verification, response dispatch, daily activity reports.',
  },
];

const profile = [
  'Integrity. Background check on every candidate.',
  'Rigour. Punctuality, presentation, procedure-aligned.',
  'Physical fitness. Entry test, ongoing maintenance.',
  'Composure. Conflict de-escalation training, drills.',
  'Discretion. What you see on site stays on site.',
];

const steps = [
  {
    n: '01',
    title: 'Application',
    body: 'Send CV + cover letter. State availability and preferred Kinshasa zone.',
  },
  {
    n: '02',
    title: 'Interview',
    body: 'Meet at headquarters. Identity verification, motivation, prior experience.',
  },
  {
    n: '03',
    title: 'Training',
    body: 'Join a centre cohort — theory, practice, assessment.',
  },
  {
    n: '04',
    title: 'Assignment',
    body: 'First mission with a field mentor. 30-day review, contract confirmed.',
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
const careersWaMessage = 'Hello GSS, I am reaching out from your website. I would like to apply — here is my profile…';
---

<BaseLayout
  title="Careers"
  description="Join GSS Congo: prevention agents, post chiefs, K9 handlers, escort drivers, elite security, supervision. Cohort-based recruitment."
  lang="en"
  altLocaleHref="/fr/carrieres/"
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cr-hero" aria-labelledby="cr-heading">
    <div class="cr-hero-image" aria-hidden="true">
      <img src="/images/banner1.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cr-hero-overlay"></div>
    </div>
    <div class="cr-hero-content">
      <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>Careers</p>
      <h1 id="cr-heading" class="cr-hero-title" data-reveal data-reveal-delay="120">
        The discipline. And a future.
      </h1>
      <p class="cr-hero-intro" data-reveal data-reveal-delay="240">
        We recruit by cohorts, in lockstep with our training centre. No
        permanent vacancies on display — a received application joins the
        pool and finds its cohort. The house trains, deploys, supports,
        and helps people grow.
      </p>
    </div>
  </section>

  <!-- ─── MANIFESTO ──────────────────────────────────────────── -->
  <section class="cr-section cr-manifest" aria-labelledby="cr-manifest-heading">
    <div class="cr-manifest-frame">
      <p class="cr-eyebrow" data-reveal>Manifesto</p>
      <p id="cr-manifest-heading" class="cr-manifest-text" data-reveal data-reveal-delay="120">
        Serving as an agent is not improvised. It is learned, verified, and
        renewed. We are looking for people ready to enter that discipline —
        and stay there.
      </p>
    </div>
  </section>

  <!-- ─── WHY (dark band) ─────────────────────────────────────── -->
  <section class="cr-section cr-why" aria-labelledby="cr-why-heading">
    <div class="cr-why-frame">
      <div class="cr-why-head">
        <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>Why join</p>
        <h2 id="cr-why-heading" class="cr-section-heading cr-section-heading-on-dark" data-reveal data-reveal-delay="100">
          3 commitments, to every agent.
        </h2>
      </div>
      <ol class="cr-why-grid">
        {principles.map((p, i) => (
          <li
            class="cr-why-item"
            data-reveal
            data-reveal-delay={String(150 + i * 120)}
            style={`--reveal-delay: ${150 + i * 120}ms;`}
          >
            <span class="cr-why-num">{p.n}</span>
            <h3 class="cr-why-title">{p.title}</h3>
            <p class="cr-why-body">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── ROLES ──────────────────────────────────────────────── -->
  <section class="cr-section cr-roles" aria-labelledby="cr-roles-heading">
    <div class="cr-roles-frame">
      <div class="cr-roles-head">
        <p class="cr-eyebrow" data-reveal>Roles</p>
        <h2 id="cr-roles-heading" class="cr-section-heading" data-reveal data-reveal-delay="100">
          6 crafts of the house.
        </h2>
        <p class="cr-roles-sub" data-reveal data-reveal-delay="200">
          The roles open continuously, by cohort. The bridge between each
          role runs through internal training.
        </p>
      </div>
      <ol class="cr-roles-list">
        {roles.map((r, i) => (
          <li
            class="cr-role"
            data-reveal
            data-reveal-delay={String(150 + i * 90)}
            style={`--reveal-delay: ${150 + i * 90}ms;`}
          >
            <span class="cr-role-num" aria-hidden="true">/ {String(i + 1).padStart(2, '0')}</span>
            <div class="cr-role-text">
              <h3 class="cr-role-name">{r.name}</h3>
              <p class="cr-role-body">{r.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── PROFILE ────────────────────────────────────────────── -->
  <section class="cr-section cr-profile" aria-labelledby="cr-profile-heading">
    <div class="cr-profile-frame">
      <div class="cr-profile-head">
        <p class="cr-eyebrow" data-reveal>Who we look for</p>
        <h2 id="cr-profile-heading" class="cr-section-heading" data-reveal data-reveal-delay="100">
          5 qualities. Non-negotiable.
        </h2>
      </div>
      <ul class="cr-profile-list" aria-label="5 expected qualities">
        {profile.map((p, i) => (
          <li
            class="cr-profile-item"
            data-reveal
            data-reveal-delay={String(150 + i * 80)}
            style={`--reveal-delay: ${150 + i * 80}ms;`}
          >
            <span class="cr-profile-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="cr-profile-text">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── HOW TO APPLY (dark band) ────────────────────────────── -->
  <section class="cr-section cr-apply" aria-labelledby="cr-apply-heading">
    <div class="cr-apply-frame">
      <div class="cr-apply-head">
        <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>How to apply</p>
        <h2 id="cr-apply-heading" class="cr-section-heading cr-section-heading-on-dark" data-reveal data-reveal-delay="100">
          4 steps, no fog.
        </h2>
      </div>
      <ol class="cr-apply-grid">
        {steps.map((s, i) => (
          <li
            class="cr-apply-step"
            data-reveal
            data-reveal-delay={String(150 + i * 100)}
            style={`--reveal-delay: ${150 + i * 100}ms;`}
          >
            <span class="cr-apply-num">{s.n}</span>
            <h3 class="cr-apply-title">{s.title}</h3>
            <p class="cr-apply-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── APPLICATION (form with CV upload) ───────────────────── -->
  <section class="cr-cta" aria-labelledby="cr-cta-heading">
    <div class="cr-cta-frame">
      <div class="cr-cta-text" data-reveal>
        <p class="cr-eyebrow cr-eyebrow-on-dark">Apply</p>
        <h2 id="cr-cta-heading" class="cr-cta-heading">
          Send your application.
        </h2>
        <p class="cr-cta-sub">
          CV + cover letter. Availability, preferred zone, prior experience
          if any. We come back within 7 business days to schedule an
          interview or point you to the next cohort.
        </p>
        <p class="cr-cta-phone">
          Or call us,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.en}</span>
        </p>
        <p class="cr-cta-wa">
          <a href={whatsappLink(careersWaMessage)} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cr-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cr-notice" role="status">
            <strong>Form awaiting configuration.</strong>
            WhatsApp and phone remain open in the meantime.
          </p>
        )}

        <form
          class="cr-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          enctype="multipart/form-data"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/en/thank-you/`} />
          <input type="hidden" name="from_name" value="GSS Congo — application" />
          <input type="hidden" name="subject" value="New application from gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cr-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cr-row">
            <label class="cr-field">
              <span class="cr-label">Full name *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cr-field">
              <span class="cr-label">Phone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cr-field">
            <span class="cr-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label class="cr-field">
            <span class="cr-label">Role</span>
            <select name="role">
              <option value="">— Choose a role —</option>
              {roles.map((r) => (
                <option value={r.name}>{r.name}</option>
              ))}
              <option value="other">Other / to discuss</option>
            </select>
          </label>

          <div class="cr-row">
            <label class="cr-field">
              <span class="cr-label">Preferred Kinshasa zone</span>
              <input type="text" name="zone" placeholder="Gombe, Limete, Lemba…" />
            </label>
            <label class="cr-field">
              <span class="cr-label">Availability</span>
              <input type="text" name="availability" placeholder="Immediate, 1 month, etc." />
            </label>
          </div>

          <label class="cr-field">
            <span class="cr-label">CV (PDF or Word, 5 MB max)</span>
            <input
              type="file"
              name="cv"
              accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            />
          </label>

          <label class="cr-field">
            <span class="cr-label">A few words about your motivation</span>
            <textarea name="message" rows="4" placeholder="Experience, interest, personal context…"></textarea>
          </label>

          <p class="cr-fineprint">
            Your information stays confidential and is used only to process
            your application.
          </p>

          <div class="cr-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Send my application
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cr-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cr-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cr-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
    filter: saturate(0.88);
    animation: cr-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cr-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cr-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cr-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cr-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 14em;
    text-wrap: balance;
  }
  .cr-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 40em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cr-section {
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cr-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cr-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cr-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cr-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cr-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cr-section-heading-on-dark { color: var(--color-cream); }

  /* ─── MANIFESTO ────────────────────────────────────────────── */
  .cr-manifest {
    background: var(--color-cream);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .cr-manifest-frame { max-width: 920px; margin-inline: auto; }
  .cr-manifest-text {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 420, 'SOFT' 40;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* ─── WHY (dark band) ──────────────────────────────────────── */
  .cr-why {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cr-why::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 60% at 90% 10%, oklch(40% 0.06 70 / 0.22), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cr-why-frame { max-width: 1280px; margin-inline: auto; }
  .cr-why-head { max-width: 44rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cr-why-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) { .cr-why-grid { grid-template-columns: repeat(3, 1fr); } }
  .cr-why-item {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) {
    .cr-why-item { border-bottom: none; }
    .cr-why-item:last-child { border-right: none; }
  }
  @media (max-width: 1023px) {
    .cr-why-item:last-child { border-bottom: none; border-right: none; }
  }
  .cr-why-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.875rem;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }
  .cr-why-title {
    margin: 1rem 0 0.875rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.15;
    color: var(--color-cream);
    letter-spacing: -0.015em;
    max-width: 16em;
    text-wrap: balance;
  }
  .cr-why-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 28em;
  }

  /* ─── ROLES ───────────────────────────────────────────────── */
  .cr-roles { background: var(--color-cream); }
  .cr-roles-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 1024px) {
    .cr-roles-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: start;
    }
  }
  .cr-roles-head { max-width: 30rem; }
  .cr-roles-sub {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
  }
  .cr-roles-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .cr-role {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-hairline-on-light);
    align-items: baseline;
  }
  .cr-role:last-child { border-bottom: 1px solid var(--color-hairline-on-light); }
  .cr-role-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.9375rem;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    padding-top: 0.25rem;
  }
  .cr-role-text { display: flex; flex-direction: column; gap: 0.5rem; }
  .cr-role-name {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .cr-role-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 38em;
  }

  /* ─── PROFILE ──────────────────────────────────────────────── */
  .cr-profile { background: var(--color-cream-2); }
  .cr-profile-frame { max-width: 1280px; margin-inline: auto; }
  .cr-profile-head { max-width: 36rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cr-profile-list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-hairline-on-light);
  }
  @media (min-width: 1024px) {
    .cr-profile-list { grid-template-columns: repeat(5, 1fr); }
  }
  .cr-profile-item {
    padding: 1.75rem 1.25rem 1.75rem 0;
    border-bottom: 1px solid var(--color-hairline-on-light);
    border-right: 1px solid var(--color-hairline-on-light);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  @media (min-width: 1024px) {
    .cr-profile-item { border-bottom: none; }
    .cr-profile-item:last-child { border-right: none; }
  }
  @media (max-width: 1023px) {
    .cr-profile-item:last-child { border-bottom: none; border-right: none; }
  }
  .cr-profile-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.875rem;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }
  .cr-profile-text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* ─── HOW TO APPLY (dark band) ─────────────────────────────── */
  .cr-apply {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cr-apply::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 60% at 10% 10%, oklch(40% 0.06 70 / 0.22), transparent 70%);
