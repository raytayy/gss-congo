---
/*
 * /en/careers/ — Open positions (EN). Mirror of /fr/carrieres/index.astro.
 * Structure: Hero → Open positions → FAQ → Profile compact → Apply (form).
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';
import { breadcrumbSchema } from '@lib/jsonld';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com/';
const breadcrumbs = breadcrumbSchema(
  [
    { name: 'Home', path: '/en/' },
    { name: 'Careers', path: '/en/careers/' },
  ],
  siteUrl,
);

type RoleStatus = 'open' | 'next' | 'waitlist';

interface Role {
  code: string;
  name: string;
  summary: string;
  status: RoleStatus;
  type: string;
}

const roles: Role[] = [
  {
    code: 'AGT-01',
    name: 'Prevention & security agent',
    summary: 'The common core. Static presence, access control, perimeter patrol, radio communication.',
    status: 'open',
    type: 'Permanent · cohort',
  },
  {
    code: 'CHP-01',
    name: 'Post chief',
    summary: 'Site team coordination, rotation supervision, client interface, incident reporting.',
    status: 'next',
    type: 'Permanent · cohort',
  },
  {
    code: 'K9-01',
    name: 'Canine handler & K9',
    summary: 'Two-handler work with response dogs. Continuous training, animal care and conditioning.',
    status: 'waitlist',
    type: 'Permanent · cohort',
  },
  {
    code: 'DRV-01',
    name: 'Escort driver',
    summary: 'Certified defensive driving, route study, convoy coordination, posture under incident.',
    status: 'next',
    type: 'Permanent · cohort',
  },
  {
    code: 'VIP-01',
    name: 'Elite security agent',
    summary: 'Civilian dress, protocol, VIP escort. Selected after several years in standard guarding.',
    status: 'waitlist',
    type: 'Permanent · selection',
  },
  {
    code: 'SUP-01',
    name: 'Supervision centre operator',
    summary: '24/7 camera watch, doubt verification, response dispatch, daily activity reports.',
    status: 'open',
    type: 'Permanent · 3×8 shift',
  },
];

const statusLabel: Record<RoleStatus, string> = {
  open: 'Open',
  next: 'Next cohort',
  waitlist: 'Waitlist',
};

// Careers routes through the training centre — show its dedicated line.
const careersPhone = contact.phones.training[0];
const phoneTel = `tel:${careersPhone.tel}`;
const phoneDisplay = careersPhone.display;
const careersWaMessage = 'Hello GSS, I am reaching out from your website. I would like to apply as an agent. Please get back to me with the next cohort details.';
---

<BaseLayout
  title="Security careers & recruitment Kinshasa — GSS Congo"
  description="Join the agents who protect Kinshasa. Continuous recruitment, in-house training, field and supervisory roles. Apply online at GSS Congo."
  lang="en"
  altLocaleHref="/fr/carrieres/"
  jsonLd={breadcrumbs}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cr-hero" aria-labelledby="cr-heading">
    <div class="cr-hero-image" aria-hidden="true">
      <img src="/images/careers-hero.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cr-hero-overlay"></div>
    </div>
    <div class="cr-hero-content">
      <p class="cr-eyebrow cr-eyebrow-on-dark" data-reveal>Careers</p>
      <h1 id="cr-heading" class="cr-hero-title" data-reveal data-reveal-delay="120">
        Open positions.
      </h1>
      <p class="cr-hero-intro" data-reveal data-reveal-delay="240">
        We recruit by cohort, in lock-step with our training centre. 6 roles,
        3 statuses — apply to the one that speaks to you.
      </p>
      <div class="cr-hero-actions" data-reveal data-reveal-delay="360">
        <NeonButton variant="solid" size="lg" href="#cr-jobs">
          See positions
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </NeonButton>
      </div>
    </div>
  </section>

  <!-- ─── OPEN POSITIONS — catalog ────────────────────────────── -->
  <section id="cr-jobs" class="cr-section cr-jobs" aria-labelledby="cr-jobs-heading">
    <div class="cr-jobs-frame">
      <div class="cr-jobs-head">
        <p class="cr-eyebrow" data-reveal>Positions</p>
        <h2 id="cr-jobs-heading" class="cr-section-heading" data-reveal data-reveal-delay="100">
          6 roles, recruiting by cohort.
        </h2>
      </div>
      <ol class="cr-jobs-grid">
        {roles.map((r, i) => (
          <li
            class="cr-job"
            data-reveal
            data-reveal-delay={String(120 + i * 80)}
            style={`--reveal-delay: ${120 + i * 80}ms;`}
          >
            <header class="cr-job-head">
              <span class="cr-job-code">{r.code}</span>
              <span class={`cr-job-status cr-job-status-${r.status}`}>
                <span class="cr-job-dot" aria-hidden="true"></span>
                {statusLabel[r.status]}
              </span>
            </header>
            <h3 class="cr-job-name">{r.name}</h3>
            <p class="cr-job-body">{r.summary}</p>
            <ul class="cr-job-pills" aria-label="Role characteristics">
              <li>Kinshasa</li>
              <li>{r.type}</li>
              <li>Training included</li>
            </ul>
            <a class="cr-job-apply" href={`#cr-apply?role=${r.code}`} data-role={r.code}>
              Apply for this role
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── PROFILE — compact inline row ────────────────────────── -->
  <section class="cr-section cr-profile" aria-labelledby="cr-profile-heading">
    <div class="cr-profile-frame">
      <p class="cr-eyebrow" data-reveal>Who we look for</p>
      <h2 id="cr-profile-heading" class="cr-profile-heading" data-reveal data-reveal-delay="100">
        Integrity, rigour, fitness, composure, discretion.
      </h2>
      <p class="cr-profile-sub" data-reveal data-reveal-delay="200">
        Non-negotiable. Background check on every candidate at entry.
      </p>
      <p class="cr-profile-link" data-reveal data-reveal-delay="280">
        <a href="/en/faq/#careers">
          Questions on cohorts, training or salary?
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ─── APPLY (form with CV upload) ─────────────────────────── -->
  <section id="cr-apply" class="cr-cta" aria-labelledby="cr-cta-heading">
    <div class="cr-cta-frame">
      <div class="cr-cta-text" data-reveal>
        <p class="cr-eyebrow cr-eyebrow-on-dark">Apply</p>
        <h2 id="cr-cta-heading" class="cr-cta-heading">
          Send us your dossier.
        </h2>
        <p class="cr-cta-sub">
          CV + cover letter. State availability, preferred zone and prior
          experience if any. We get back within 7 working days to schedule
          an interview or point you to the next cohort.
        </p>
        <p class="cr-cta-phone">
          Or call us,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.en}</span>
        </p>
        <p class="cr-cta-wa">
          <a href={whatsappLink(careersWaMessage)} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cr-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cr-notice" role="status">
            <strong>Form awaiting configuration.</strong>
            In the meantime, WhatsApp and phone are open.
          </p>
        )}

        <form
          class="cr-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          enctype="multipart/form-data"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/en/thank-you/`} />
          <input type="hidden" name="from_name" value="GSS Congo — application" />
          <input type="hidden" name="subject" value="New application from gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cr-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cr-row">
            <label class="cr-field">
              <span class="cr-label">Full name *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cr-field">
              <span class="cr-label">Phone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cr-field">
            <span class="cr-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <label class="cr-field">
            <span class="cr-label">Preferred role</span>
            <select name="role" id="cr-role-select">
              <option value="">— Choose a role —</option>
              {roles.map((r) => (
                <option value={`${r.code} — ${r.name}`} data-code={r.code}>
                  {r.code} — {r.name}
                </option>
              ))}
              <option value="other">Other / open to discuss</option>
            </select>
          </label>

          <div class="cr-row">
            <label class="cr-field">
              <span class="cr-label">Preferred Kinshasa zone</span>
              <input type="text" name="zone" placeholder="Gombe, Limete, Lemba…" />
            </label>
            <label class="cr-field">
              <span class="cr-label">Availability</span>
              <input type="text" name="availability" placeholder="Immediate, 1 month, etc." />
            </label>
          </div>

          <label class="cr-field">
            <span class="cr-label">CV (PDF or Word, 5 MB max)</span>
            <input
              type="file"
              name="cv"
              accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            />
          </label>

          <label class="cr-field">
            <span class="cr-label">A few words on your motivation</span>
            <textarea name="message" rows="4" placeholder="Experience, interest, personal context…"></textarea>
          </label>

          <p class="cr-fineprint">
            Your information stays confidential and is only used to process
            your application.
          </p>

          <div class="cr-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Submit my application
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script>
    function preselectRole() {
      const select = document.getElementById('cr-role-select') as HTMLSelectElement | null;
      if (!select) return;
      let code = new URLSearchParams(window.location.search).get('role');
      if (!code && window.location.hash.startsWith('#cr-apply')) {
        const q = window.location.hash.split('?')[1] ?? '';
        code = new URLSearchParams(q).get('role');
      }
      if (!code) return;
      const opt = Array.from(select.options).find((o) => o.dataset.code === code);
      if (opt) select.value = opt.value;
    }

    function wireJobApplyLinks() {
      document.querySelectorAll<HTMLAnchorElement>('.cr-job-apply').forEach((a) => {
        a.addEventListener('click', (e) => {
          const code = a.dataset.role;
          const select = document.getElementById('cr-role-select') as HTMLSelectElement | null;
          if (code && select) {
            const opt = Array.from(select.options).find((o) => o.dataset.code === code);
            if (opt) select.value = opt.value;
          }
          const target = document.getElementById('cr-apply');
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', `?role=${code}#cr-apply`);
          }
        });
      });
    }

    preselectRole();
    wireJobApplyLinks();
    document.addEventListener('astro:page-load', () => {
      preselectRole();
      wireJobApplyLinks();
    });
  </script>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cr-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cr-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cr-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: cr-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cr-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cr-hero-overlay {
    position: absolute; inset: 0;
    background: none;
  }
  .cr-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cr-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 14em;
    text-wrap: balance;
  }
  .cr-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 40em;
    opacity: 0.92;
  }
  .cr-hero-actions {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cr-section {
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cr-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cr-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cr-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cr-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cr-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cr-section-heading-on-dark { color: var(--color-cream); }

  /* ─── OPEN POSITIONS ───────────────────────────────────────── */
  .cr-jobs { background: var(--color-cream); }
  .cr-jobs-frame { max-width: 1280px; margin-inline: auto; }
  .cr-jobs-head { max-width: 38rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cr-jobs-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 720px)  { .cr-jobs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .cr-jobs-grid { grid-template-columns: repeat(3, 1fr); } }

  .cr-job {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 2.4vw, 2rem);
    background: var(--color-cream-2);
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-md);
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
  }
  .cr-job:hover {
    transform: translateY(-2px);
    border-color: var(--color-bronze);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 24px 48px -20px oklch(20% 0.04 250 / 0.25);
  }
  .cr-job-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .cr-job-code {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    font-variant-numeric: tabular-nums;
  }
  .cr-job-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--color-hairline-on-light);
    background: var(--color-cream);
    color: var(--color-ink);
  }
  .cr-job-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-mute-on-light);
  }
  .cr-job-status-open .cr-job-dot {
    background: oklch(68% 0.16 145);
    box-shadow: 0 0 0 3px oklch(68% 0.16 145 / 0.18);
  }
  .cr-job-status-next .cr-job-dot {
    background: var(--color-bronze);
    box-shadow: 0 0 0 3px oklch(70% 0.10 70 / 0.18);
  }
  .cr-job-status-waitlist .cr-job-dot {
    background: oklch(55% 0 0);
    box-shadow: 0 0 0 3px oklch(55% 0 0 / 0.12);
  }
  .cr-job-name {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .cr-job-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-mute-on-light);
  }
  .cr-job-pills {
    list-style: none; margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .cr-job-pills li {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-xs);
    background: var(--color-cream);
    border: 1px solid var(--color-hairline-on-light);
    color: var(--color-mute-on-light);
  }
  .cr-job-apply {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-bronze-deep);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid transparent;
    align-self: flex-start;
    transition:
      color var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      gap var(--duration-normal) var(--ease-out-expo);
  }
  .cr-job-apply:hover {
    color: var(--color-bronze);
    border-bottom-color: var(--color-bronze);
    gap: 0.75rem;
  }

  /* ─── PROFILE — compact ────────────────────────────────────── */
  .cr-profile { background: var(--color-cream); }
  .cr-profile-frame { max-width: 1080px; margin-inline: auto; }
  .cr-profile-heading {
    margin: 0.75rem 0 1rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 22em;
    text-wrap: balance;
  }
  .cr-profile-sub {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }
  .cr-profile-link {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: 0.9375rem;
  }
  .cr-profile-link a {
    color: var(--color-bronze-deep);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-hairline-on-light);
    padding-bottom: 0.15rem;
    transition:
      color var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      gap var(--duration-normal) var(--ease-out-expo);
  }
  .cr-profile-link a:hover {
    color: var(--color-bronze);
    border-color: var(--color-bronze);
    gap: 0.75rem;
  }

  /* ─── CTA (dark) — form ────────────────────────────────────── */
  .cr-cta {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: clamp(5rem, 12vw, 11rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
    scroll-margin-top: 4rem;
  }
  .cr-cta::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 50% at 50% 100%, oklch(40% 0.06 70 / 0.22), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cr-cta-frame {
    position: relative;
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .cr-cta-frame { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 5rem; }
  }
  .cr-cta-heading {
    margin: 1rem 0 1.25rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    max-width: 14em;
    text-wrap: balance;
  }
  .cr-cta-sub {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.80;
    max-width: 36em;
  }
