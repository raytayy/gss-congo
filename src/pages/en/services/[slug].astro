---
/*
 * /en/services/[slug]/ — Service detail page (EN).
 * Mirror of /fr/services/[slug].astro.
 * Beats: Hero → Scope → Method → Audience → CTA → Related.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { services, getServiceUrl } from '@lib/services';
import { contact, whatsappLink } from '@lib/contact';
import { serviceSchema, breadcrumbSchema, faqPageSchema } from '@lib/jsonld';
import type { FaqItem } from '@lib/faq';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return services.map((s) => ({
    params: { slug: s.slug.en },
    props: { service: s },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;
const altLocaleHref = getServiceUrl(service, 'fr');

const serviceIndex = services.findIndex((s) => s.slug.en === service.slug.en);
const serviceNumber = String(serviceIndex + 1).padStart(2, '0');

const siblings = [...services.slice(serviceIndex + 1), ...services.slice(0, serviceIndex)].slice(0, 3);

const methodSteps = [
  {
    n: '01',
    title: 'Audit',
    body: 'Site visit, risk and sensitive-point mapping, listening to operational constraints.',
  },
  {
    n: '02',
    title: 'Plan',
    body: 'Calibrated posture: headcount, rotation, equipment, response procedures. Validated with you.',
  },
  {
    n: '03',
    title: 'Deployment',
    body: 'Go-live, team briefing, integration with site flows. First week under reinforced supervision.',
  },
  {
    n: '04',
    title: 'Supervision',
    body: '24/7 central coordination, activity reports, continuous adjustment from field feedback.',
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
const waMessage = `Hello GSS, I am reaching out from your website. I would like a quote for your ${service.name.en} service. Please get back to me.`;

// Per-service FAQ (top 3 priority services). The visible HTML and the
// faqPageSchema mainEntity must be identical — Google penalises mismatches.
// Keyed by EN slug.
const serviceFaqs: Record<string, FaqItem[]> = {
  'guarding-and-intervention': [
    {
      q: {
        fr: 'En combien de temps vos équipes interviennent-elles à Kinshasa ?',
        en: 'How quickly do your teams respond in Kinshasa?',
      },
      a: {
        fr: "L'objectif opérationnel de GSS Congo est une intervention sous 20 minutes sur Kinshasa, 24h/24, grâce au maillage des sites et à un dispatching radio centralisé.",
        en: "GSS Congo's operational target is a response under 20 minutes in Kinshasa, 24/7, thanks to a network of sites and centralised radio dispatching.",
      },
    },
    {
      q: {
        fr: 'Vos agents de gardiennage sont-ils armés ?',
        en: 'Are your guards armed?',
      },
      a: {
        fr: 'La doctrine de GSS Congo respecte le cadre légal congolais. Le détail des dotations est précisé site par site selon le contexte du contrat et l\'analyse de risque.',
        en: "GSS Congo's doctrine follows the Congolese legal framework. The detail of equipment is set site by site according to the contract and the risk assessment.",
      },
    },
    {
      q: {
        fr: 'Pouvez-vous gérer un site 24h/24, 7j/7 ?',
        en: 'Can you cover a site 24/7?',
      },
      a: {
        fr: 'Oui. La couverture 24/7 est la posture par défaut de GSS Congo pour le gardiennage statique, avec rotations d\'équipes et supervision continue.',
        en: "Yes. 24/7 coverage is GSS Congo's default posture for static guarding, with team rotations and continuous supervision.",
      },
    },
    {
      q: {
        fr: 'Travaillez-vous en dehors de Kinshasa ?',
        en: 'Do you work outside Kinshasa?',
      },
      a: {
        fr: 'La couverture principale est Kinshasa et les régions avoisinantes. Pour d\'autres villes, GSS étudie chaque demande au cas par cas — contactez-nous via le formulaire de devis.',
        en: 'Primary coverage is Kinshasa and surrounding regions. For other cities, GSS studies each request case by case — contact us via the quote form.',
      },
    },
  ],
  'residential-security': [
    {
      q: {
        fr: 'Quels quartiers de Kinshasa couvrez-vous ?',
        en: 'Which Kinshasa neighbourhoods do you cover?',
      },
      a: {
        fr: 'Nous intervenons sur toute la commune de la Gombe et les principaux quartiers résidentiels de Kinshasa (Ma Campagne, Mont-Fleury, Binza, Limete-résidentiel, Macampagne). Demandez une étude pour les quartiers périphériques.',
        en: 'We cover the entire Gombe commune and the main residential neighbourhoods of Kinshasa (Ma Campagne, Mont-Fleury, Binza, Limete-residential, Macampagne). Ask for a study for outlying areas.',
      },
    },
    {
      q: {
        fr: 'Combien de gardiens dédiez-vous à une résidence ?',
        en: 'How many guards do you assign to a residence?',
      },
      a: {
        fr: "Selon le périmètre, la posture varie d'un gardien aux heures convenues à un dispositif 24/7 en trois rotations. Le dimensionnement sort de l'audit de site initial.",
        en: 'Depending on the perimeter, the posture ranges from a single guard at scheduled hours to a 24/7 deployment across three rotations. Sizing comes from the initial site audit.',
      },
    },
    {
      q: {
        fr: 'Vos agents sont-ils formés à la confidentialité ?',
        en: 'Are your agents trained in confidentiality?',
      },
      a: {
        fr: 'Oui. La discrétion fait partie du tronc commun de formation à notre centre interne : protocole familial, gestion des livraisons, posture face aux visiteurs et au personnel de maison.',
        en: 'Yes. Discretion is part of the core curriculum at our in-house training centre: family protocol, delivery handling, posture with visitors and household staff.',
      },
    },
  ],
  'video-surveillance': [
    {
      q: {
        fr: 'Quel est le délai de levée de doute en cas d\'alerte ?',
        en: 'What is the doubt-verification time when an alert fires?',
      },
      a: {
        fr: 'Notre centre de supervision lève le doute en moins de 90 secondes en moyenne, puis dispatche immédiatement l\'équipe d\'intervention si la situation le justifie.',
        en: 'Our supervision centre verifies an alert in under 90 seconds on average, then immediately dispatches the response team if the situation requires it.',
      },
    },
    {
      q: {
        fr: 'Combien de temps les enregistrements sont-ils conservés ?',
        en: 'How long are recordings retained?',
      },
      a: {
        fr: 'Archivage sécurisé sur 30 jours minimum, extensible sur demande contractuelle. Les flux sont chiffrés et stockés sur NVR redondé.',
        en: 'Secure archiving for 30 days minimum, extendable on contractual request. Streams are encrypted and stored on a redundant NVR.',
      },
    },
    {
      q: {
        fr: 'La supervision tourne-t-elle vraiment 24h/24 ?',
        en: 'Does supervision really run 24/7?',
      },
      a: {
        fr: 'Oui. Le centre de supervision GSS est opéré en continu, avec rotations d\'équipes et coordination directe avec les agents d\'intervention sur Kinshasa.',
        en: "Yes. GSS's supervision centre runs continuously, with team rotations and direct coordination with the response agents in Kinshasa.",
      },
    },
  ],
};

const faqs = serviceFaqs[service.slug.en];

// SEO: Service + Breadcrumb (+ optional FAQ) structured data — ALL 9 services
// emit Service schema; top 3 also emit FAQPage matching the visible block below.
const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com';
const jsonLd = [
  serviceSchema(service, 'en', siteUrl),
  breadcrumbSchema(
    [
      { name: 'Home', path: '/en/' },
      { name: 'Services', path: '/en/services/' },
      { name: service.name.en, path: getServiceUrl(service, 'en') },
    ],
    siteUrl,
  ),
  ...(faqs ? [faqPageSchema('en', faqs)] : []),
];
---

<BaseLayout
  title={service.seoTitle?.en ?? service.name.en}
  description={service.metaDescription?.en ?? service.blurb.en}
  lang="en"
  altLocaleHref={altLocaleHref}
  ogImage={service.heroImage ?? service.image}
  jsonLd={jsonLd}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="svc-hero" aria-labelledby="svc-heading">
    <div class="svc-hero-image" aria-hidden="true">
      <img
        src={service.heroImage ?? service.image}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="2400"
        height="1600"
      />
      <div class="svc-hero-overlay"></div>
    </div>
    <div class="svc-hero-content">
      <p class="svc-hero-eyebrow" data-reveal>
        <a href="/en/services/">Services</a>
        <span class="svc-hero-sep" aria-hidden="true">/</span>
        <span class="svc-hero-num">{serviceNumber}</span>
      </p>
      <h1 id="svc-heading" class="svc-hero-title" data-reveal data-reveal-delay="120">
        {service.name.en}
      </h1>
      {service.intro && (
        <p class="svc-hero-intro" data-reveal data-reveal-delay="240">{service.intro.en}</p>
      )}
    </div>
  </section>

  <!-- ─── SCOPE ───────────────────────────────────────────────── -->
  {service.scope && (
    <section class="svc-section svc-scope" aria-labelledby="svc-scope-heading">
      <div class="svc-scope-frame">
        <div class="svc-scope-label">
          <p class="svc-eyebrow" data-reveal>Scope</p>
          <h2 id="svc-scope-heading" class="svc-section-heading" data-reveal data-reveal-delay="100">
            What we take on.
          </h2>
        </div>
        <ol class="svc-scope-list">
          {service.scope.en.map((item, i) => (
            <li
              data-reveal
              data-reveal-delay={String(120 + i * 80)}
              style={`--reveal-delay: ${120 + i * 80}ms;`}
            >
              <span class="svc-scope-num" aria-hidden="true">/ {String(i + 1).padStart(2, '0')}</span>
              <span class="svc-scope-text">{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- ─── METHOD ──────────────────────────────────────────────── -->
  <section class="svc-section svc-method" aria-labelledby="svc-method-heading">
    <div class="svc-method-frame">
      <div class="svc-method-head">
        <p class="svc-eyebrow svc-eyebrow-on-dark" data-reveal>Method</p>
        <h2 id="svc-method-heading" class="svc-section-heading svc-method-heading" data-reveal data-reveal-delay="100">
          4 steps, on every site.
        </h2>
        <p class="svc-method-sub" data-reveal data-reveal-delay="200">
          No posture is copy-pasted. The same protocol is applied to every
          mission, from residential to industrial.
        </p>
      </div>
      <ol class="svc-method-grid">
        {methodSteps.map((step, i) => (
          <li
            class="svc-method-step"
            data-reveal
            data-reveal-delay={String(150 + i * 100)}
            style={`--reveal-delay: ${150 + i * 100}ms;`}
          >
            <span class="svc-method-num">{step.n}</span>
            <h3 class="svc-method-title">{step.title}</h3>
            <p class="svc-method-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── AUDIENCE ────────────────────────────────────────────── -->
  {service.audience && (
    <section class="svc-section svc-audience" aria-labelledby="svc-audience-heading">
      <div class="svc-audience-frame">
        <p class="svc-eyebrow" data-reveal>Who it's for</p>
        <p id="svc-audience-heading" class="svc-audience-text" data-reveal data-reveal-delay="120">
          {service.audience.en}
        </p>
      </div>
    </section>
  )}

  <!-- ─── FAQ (top 3 services only) ──────────────────────────── -->
  {faqs && (
    <section class="svc-section svc-faq" aria-labelledby="svc-faq-heading">
      <div class="svc-faq-frame">
        <div class="svc-faq-head">
          <p class="svc-eyebrow" data-reveal>FAQ</p>
          <h2 id="svc-faq-heading" class="svc-section-heading" data-reveal data-reveal-delay="100">
            What clients ask us most.
          </h2>
        </div>
        <ul class="svc-faq-list">
          {faqs.map((item, i) => (
            <li
              class="svc-faq-item"
              data-reveal
              data-reveal-delay={String(120 + i * 80)}
              style={`--reveal-delay: ${120 + i * 80}ms;`}
            >
              <details class="svc-faq-details">
                <summary class="svc-faq-question">
                  <span class="svc-faq-q-text">{item.q.en}</span>
                  <span class="svc-faq-q-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </summary>
                <p class="svc-faq-answer">{item.a.en}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ─── CTA ────────────────────────────────────────────────── -->
  <section class="svc-cta" aria-labelledby="svc-cta-heading">
    <div class="svc-cta-frame">
      <div class="svc-cta-text" data-reveal>
        <p class="svc-eyebrow svc-eyebrow-on-dark">Quote</p>
        <h2 id="svc-cta-heading" class="svc-cta-heading">
          Let's talk about your specific need.
        </h2>
        <p class="svc-cta-sub">
          Every posture is calibrated on site. Tell us about your context —
          we come back within 24 hours with a proposal.
        </p>
      </div>
      <div class="svc-cta-actions" data-reveal data-reveal-delay="200">
        <NeonButton variant="solid" size="lg" href="/en/contact/">
          Request a quote
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </NeonButton>
        <NeonButton
          variant="default"
          size="lg"
          href={whatsappLink(waMessage)}
          target="_blank"
          rel="noopener noreferrer"
        >
          WhatsApp
        </NeonButton>
      </div>
      <p class="svc-cta-phone" data-reveal data-reveal-delay="320">
        Or call us —
        <a href={phoneTel}>{phoneDisplay}</a>
        <span aria-hidden="true">·</span>
        <span>{contact.hours.en}</span>
      </p>
    </div>
  </section>

  <!-- ─── RELATED ─────────────────────────────────────────────── -->
  <section class="svc-section svc-related" aria-labelledby="svc-related-heading">
    <div class="svc-related-frame">
      <p class="svc-eyebrow" data-reveal>See also</p>
      <h2 id="svc-related-heading" class="svc-section-heading" data-reveal data-reveal-delay="100">
        Three other crafts of the house.
      </h2>
      <ul class="svc-related-grid">
        {siblings.map((s, i) => {
          const idx = services.findIndex((x) => x.slug.en === s.slug.en);
          const num = String(idx + 1).padStart(2, '0');
          return (
            <li
              class="svc-related-item"
              data-reveal
              data-reveal-delay={String(150 + i * 120)}
              style={`--reveal-delay: ${150 + i * 120}ms;`}
            >
              <a class="svc-related-link" href={getServiceUrl(s, 'en')}>
                <div class="svc-related-media">
                  <img src={s.image} alt="" loading="lazy" decoding="async" />
                  <div class="svc-related-tone" aria-hidden="true"></div>
                </div>
                <div class="svc-related-content">
                  <span class="svc-related-num" aria-hidden="true">/ {num}</span>
                  <h3 class="svc-related-name">{s.name.en}</h3>
                  <p class="svc-related-blurb">{s.blurb.en}</p>
                  <span class="svc-related-cue">
                    Discover
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .svc-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .svc-hero-image { position: absolute; inset: 0; z-index: -1; }
  .svc-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    animation: svc-ken-burns 24s ease-out 0.4s forwards;
  }
  @keyframes svc-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .svc-hero-overlay {
    position: absolute; inset: 0;
    background: none;
  }
  .svc-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .svc-hero-eyebrow {
    text-shadow: 0 1px 12px oklch(0% 0 0 / 0.55), 0 1px 3px oklch(0% 0 0 / 0.5);
    margin: 0 0 1.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-warm);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .svc-hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-warm);
  }
  .svc-hero-eyebrow a {
    color: var(--color-cream);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity var(--duration-normal) var(--ease-out-expo), color var(--duration-normal) var(--ease-out-expo);
  }
  .svc-hero-eyebrow a:hover { color: var(--color-bronze-warm); opacity: 1; }
  .svc-hero-sep { color: var(--color-bronze-warm); opacity: 0.7; }
  .svc-hero-num { color: var(--color-cream); font-variant-numeric: tabular-nums; }
  .svc-hero-title {
    margin: 0 0 1.5rem;
    text-shadow: 0 1px 12px oklch(0% 0 0 / 0.55), 0 1px 3px oklch(0% 0 0 / 0.5);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 14em;
    text-wrap: balance;
  }
  .svc-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 38em;
    opacity: 0.92;
  }

  /* ─── SHARED SECTION CHROME ────────────────────────────────── */
  .svc-section {
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .svc-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .svc-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .svc-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .svc-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .svc-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }

  /* ─── SCOPE ────────────────────────────────────────────────── */
  .svc-scope { background: var(--color-cream); }
  .svc-scope-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 1024px) {
    .svc-scope-frame { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 5rem; }
  }
  .svc-scope-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .svc-scope-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-hairline-on-light);
    align-items: baseline;
  }
  .svc-scope-list li:last-child { border-bottom: 1px solid var(--color-hairline-on-light); }
  .svc-scope-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.9375rem;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  .svc-scope-text {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: var(--color-ink);
  }

  /* ─── METHOD (dark band) ───────────────────────────────────── */
  .svc-method {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .svc-method::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(70% 60% at 90% 0%, oklch(40% 0.06 70 / 0.20), transparent 65%);
    pointer-events: none;
    z-index: -1;
  }
  .svc-method-frame { max-width: 1280px; margin-inline: auto; }
  .svc-method-head { max-width: 44rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .svc-method-heading { color: var(--color-cream); }
  .svc-method-sub {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 36em;
  }
  .svc-method-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) { .svc-method-grid { grid-template-columns: repeat(4, 1fr); } }
  .svc-method-step {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
  }
