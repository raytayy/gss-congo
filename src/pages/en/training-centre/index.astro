---
/*
 * /en/training-centre/ — Training centre (EN). Mirror of /fr/centre-de-formation/.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';
import { educationalOrgSchema } from '@lib/jsonld';

const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com/';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const candidateJourney = [
  {
    n: '01',
    title: 'Application',
    meta: 'Reply within 7 working days',
    body: 'Send your CV, cover letter, availability and preferred Kinshasa zone. We acknowledge receipt immediately, and come back with next steps — interview scheduled or addition to the next cohort pool.',
  },
  {
    n: '02',
    title: 'Interview',
    meta: 'At HQ, in Gombe',
    body: "Meet at headquarters for an individual interview. Identity verification, motivation check, baseline physical test. Plan for 90 minutes on site. No pressure — it's also a conversation so we can get to know each other.",
  },
  {
    n: '03',
    title: 'Training',
    meta: 'By cohort invitation',
    body: 'Join the next cohort. Theory, practice, drills, final assessment. No automatic pass: each module is validated, some are retaken at the next session if needed.',
  },
  {
    n: '04',
    title: 'Assignment',
    meta: 'First mission, supervised',
    body: 'Deployment to your first site with a field mentor at your side the first week. 30-day review, contract consolidated. From that point on, the house starts investing in your long-term path.',
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
const waMessage = 'Hello GSS, I am reaching out from your website. I would like to know more about the training centre…';
---

<BaseLayout
  title="Training centre"
  description="The GSS training centre trains our agents and, on request, those of other houses. Legal framework, fire safety, K9, defensive driving, protocol."
  lang="en"
  altLocaleHref="/fr/centre-de-formation/"
  jsonLd={educationalOrgSchema('en', siteUrl)}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/careers-graphique.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Training centre</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Our agents are not recruited. They are trained.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        If you're driven by a long-term career, join the GSS training centre.
        Our new training centre prepares you for a respected and, above all,
        safe career. Our professional training programme is designed to give
        you the skills and knowledge needed to become a qualified, more than
        competent security agent.
      </p>
    </div>
  </section>

  <!-- ─── PRACTICAL TRAINING (image + paragraph, side by side) ──── -->
  <section class="cf-practical" aria-labelledby="cf-practical-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/practical-training.jpg"
          alt="GSS agents during a practical drill — coordination and movement in the training centre courtyard"
          loading="lazy"
          decoding="async"
          width="900"
          height="1000"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Practice</p>
        <h2 id="cf-practical-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Not just theory.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          GSS security agent training isn't limited to theory. A quality
          training centre offers opportunities to gain practical experience
          through real-world drills. You'll face simulated scenarios where
          you'll need to make quick decisions, manage conflicts and apply
          the right security procedures. This hands-on experience will
          effectively prepare you for the demands of the field and help you
          build your confidence and your skill.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── CANDIDATE SPACE (4-step journey) ────────────────────── -->
  <section class="cf-candidate" aria-labelledby="cf-candidate-heading">
    <div class="cf-candidate-frame">
      <header class="cf-candidate-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Candidate space</p>
        <h2 id="cf-candidate-heading" class="cf-section-heading cf-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Your journey, in 4 steps.
        </h2>
        <p class="cf-candidate-sub" data-reveal data-reveal-delay="200">
          From submitting your application to your first assignment, here is
          exactly what to expect. No grey areas.
        </p>
      </header>
      <ol class="cf-candidate-steps">
        {candidateJourney.map((step, i) => (
          <li
            class="cf-candidate-step"
            data-reveal
            data-reveal-delay={String(180 + i * 100)}
            style={`--reveal-delay: ${180 + i * 100}ms;`}
          >
            <div class="cf-candidate-step-head">
              <span class="cf-candidate-num">{step.n}</span>
              <span class="cf-candidate-meta">{step.meta}</span>
            </div>
            <h3 class="cf-candidate-step-title">{step.title}</h3>
            <p class="cf-candidate-step-body">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── ENROLMENT (form) ────────────────────────────────────── -->
  <section class="cf-cta" aria-labelledby="cf-cta-heading">
    <div class="cf-cta-frame">
      <div class="cf-cta-text" data-reveal>
        <p class="cf-eyebrow">Enrolment</p>
        <h2 id="cf-cta-heading" class="cf-cta-heading">
          Apply, or enrol your teams.
        </h2>
        <p class="cf-cta-sub">
          Individual candidates, corporate HR, diplomatic security desks.
          Cohort calendars or dedicated training on request.
        </p>
        <p class="cf-cta-phone">
          Or call us,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.en}</span>
        </p>
        <p class="cf-cta-wa">
          <a href={whatsappLink(waMessage)} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cf-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cf-notice" role="status">
            <strong>Form awaiting configuration.</strong>
            In the meantime, WhatsApp and phone are open.
          </p>
        )}

        <form
          class="cf-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/en/thank-you/`} />
          <input type="hidden" name="from_name" value="GSS Congo — training enrolment" />
          <input type="hidden" name="subject" value="New training enrolment from gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Full name *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Phone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Company (if applicable)</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Enrolment type</span>
              <select name="type">
                <option value="individual">Individual</option>
                <option value="team">Team (corporate HR)</option>
                <option value="diplomatic">Diplomatic security desk</option>
              </select>
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">A few words on your context</span>
            <textarea name="message" rows="4" placeholder="Availability, headcount to train, constraints…"></textarea>
          </label>

          <p class="cf-fineprint">
            Your information stays confidential and is only used to process
            your enrolment.
          </p>

          <div class="cf-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Send my enrolment
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 44em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── PRACTICAL (image + paragraph) ────────────────────────── */
  .cf-practical {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-practical-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cf-practical-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
    }
  }
  .cf-practical-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-practical-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.94);
    animation: cf-practical-zoom 26s ease-out 0.6s forwards;
    will-change: transform;
  }
  @keyframes cf-practical-zoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-practical-tone {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 60%, oklch(15% 0.04 250 / 0.25) 100%),
      radial-gradient(60% 50% at 10% 100%, oklch(22% 0.06 70 / 0.18), transparent 65%);
    pointer-events: none;
  }
  .cf-practical-text { display: flex; flex-direction: column; }
  .cf-practical-body {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-hero-image img,
    .cf-practical-media img { animation: none; }
  }

  /* ─── CANDIDATE SPACE ──────────────────────────────────────── */
  .cf-candidate {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-candidate::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(70% 50% at 100% 0%, oklch(40% 0.06 70 / 0.20), transparent 70%),
      radial-gradient(60% 50% at 0% 100%, oklch(40% 0.06 70 / 0.16), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cf-candidate-frame { max-width: 1280px; margin-inline: auto; }
  .cf-candidate-head {
    max-width: 44rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cf-candidate-sub {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 36em;
  }
  .cf-candidate-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) {
    .cf-candidate-steps { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cf-candidate-steps { grid-template-columns: repeat(2, 1fr); }
  }
  .cf-candidate-step {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background-color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-candidate-step:hover { background: oklch(100% 0 0 / 0.02); }
  @media (min-width: 1024px) {
    .cf-candidate-step { border-bottom: none; }
    .cf-candidate-step:last-child { border-right: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .cf-candidate-step:nth-child(2n) { border-right: none; }
    .cf-candidate-step:nth-last-child(-n+2) { border-bottom: none; }
  }
  @media (max-width: 639px) {
    .cf-candidate-step { border-right: none; }
    .cf-candidate-step:last-child { border-bottom: none; }
  }
  .cf-candidate-step-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .cf-candidate-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 460;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    line-height: 1;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }
  .cf-candidate-meta {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-warm);
    opacity: 0.78;
    text-align: right;
    max-width: 11em;
    line-height: 1.4;
  }
  .cf-candidate-step-title {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.1;
    color: var(--color-cream);
    letter-spacing: -0.015em;
  }
  .cf-candidate-step-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.82;
    max-width: 22em;
  }

  /* ─── CTA (enrolment form, cream) ──────────────────────────── */
  .cf-cta {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 12vw, 11rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-cta-frame {
    position: relative;
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: end;
  }
  @media (min-width: 1024px) {
    .cf-cta-frame { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 5rem; }
  }
  .cf-cta-heading {
    margin: 1rem 0 1.25rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 14em;
    text-wrap: balance;
  }
  .cf-cta-sub {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }
  .cf-cta-phone {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-mute-on-light);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }
  .cf-cta-phone a {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
    text-decoration-color: var(--color-bronze);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition: color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-cta-phone a:hover { color: var(--color-bronze-deep); }
  .cf-cta-phone span[aria-hidden] { color: var(--color-bronze); }
  .cf-cta-wa { margin: 0.5rem 0 0; font-size: 0.875rem; }
  .cf-cta-wa a {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline-on-light);
    padding-bottom: 0.15rem;
    transition: border-color var(--duration-normal) var(--ease-out-expo), color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-cta-wa a:hover { color: var(--color-bronze-deep); border-color: var(--color-bronze); }

  /* ─── FORM (enrolment) ─────────────────────────────────────── */
  .cf-form-wrap {
    background: var(--color-cream-2);
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .cf-notice {
    margin: 0 0 1.25rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-cream);
    border: 1px solid var(--color-bronze);
    color: var(--color-ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .cf-notice strong { color: var(--color-bronze-deep); font-weight: 500; }
  .cf-form { display: flex; flex-direction: column; gap: 1rem; }
  .cf-row { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .cf-row { grid-template-columns: 1fr 1fr; } }
  .cf-honeypot {
    position: absolute; left: -9999px; width: 1px; height: 1px;
    opacity: 0; pointer-events: none;
  }
  .cf-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .cf-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    font-weight: 500;
  }
  .cf-field input[type="text"],
  .cf-field input[type="email"],
  .cf-field input[type="tel"],
  .cf-field select,
  .cf-field textarea {
    width: 100%;
    padding: 0.7rem 0.875rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-ink);
    background: var(--color-cream);
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo);
  }
