---
/*
 * /en/training-centre/ — Training centre (EN).
 * Mirror of /fr/centre-de-formation/index.astro.
 * Beats: Hero → Manifesto → Programmes → Domains → Cycle → Location → CTA.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { contact, whatsappLink } from '@lib/contact';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const isConfigured = accessKey.length > 10;

const programmes = [
  {
    name: 'Prevention & security agent',
    body: 'The common core. Legal framework, access control, posture, note-taking, radio communication, conflict de-escalation.',
  },
  {
    name: 'Fire safety & first aid',
    body: 'SSIAP-style modules: fire prevention, evacuation, extinguisher handling, life-saving gestures.',
  },
  {
    name: 'Canine handler & K9',
    body: 'Two-handler work with response dogs: training, command, behavioural reading, supervised deterrence.',
  },
  {
    name: 'Defensive driving & escort',
    body: 'Route study, anticipation, driving under pressure, convoy coordination, posture under incident.',
  },
  {
    name: 'Protocol & elite security',
    body: 'Civilian dress, diplomatic etiquette, discreet earpiece, room-reading, VIP movements.',
  },
];

const domains = [
  'DRC legal framework',
  'First aid',
  'Fire safety',
  'Access control',
  'Perimeter patrol',
  'Radio communication',
  'Conflict de-escalation',
  'Code of conduct',
  'Response procedures',
  'Defensive driving',
  'Canine handling',
  'VIP protocol',
];

const cycle = [
  {
    n: '01',
    title: 'Recruitment',
    body: 'Selection across multiple interviews. Background checks, medical control, physical test. No shortcuts.',
  },
  {
    n: '02',
    title: 'Theory',
    body: 'Legal framework, code of conduct, first aid, fire prevention. Written assessment per module — no automatic passes.',
  },
  {
    n: '03',
    title: 'Practice',
    body: 'Live drills, access control, search procedures, conflict de-escalation, radio communication. Supervised by operational instructors.',
  },
  {
    n: '04',
    title: 'Assignment',
    body: 'Final assessment, certification, integration on site. First week with a field mentor.',
  },
];

const phoneTel = `tel:${contact.phones.primary.tel}`;
const phoneDisplay = contact.phones.primary.display;
const trainingPhones = contact.phones.training;
const trainingAddress = contact.addresses.training;
const waMessage = 'Hello GSS, I am reaching out from your website. I would like to know more about the training centre…';
---

<BaseLayout
  title="Training centre"
  description="The GSS training centre trains our agents and, on request, those of other houses. Legal framework, fire safety, K9, defensive driving, protocol."
  lang="en"
  altLocaleHref="/fr/centre-de-formation/"
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/careers-graphique.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Training centre</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Our agents are not recruited. They are trained.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        The internal school runs continuously — theory, practice, drills,
        assessment. That is our first requirement, not a sales argument.
        Cohorts enter selectively, and only leave with certification.
      </p>
    </div>
  </section>

  <!-- ─── MANIFESTO ──────────────────────────────────────────── -->
  <section class="cf-section cf-manifest" aria-labelledby="cf-manifest-heading">
    <div class="cf-manifest-frame">
      <p class="cf-eyebrow" data-reveal>Manifesto</p>
      <p id="cf-manifest-heading" class="cf-manifest-text" data-reveal data-reveal-delay="120">
        An untrained agent is not an agent — it is a uniform on a site.
        Training is not optional: it is the line between a resource and a risk.
      </p>
    </div>
  </section>

  <!-- ─── PROGRAMMES ──────────────────────────────────────────── -->
  <section class="cf-section cf-programmes" aria-labelledby="cf-programmes-heading">
    <div class="cf-programmes-frame">
      <div class="cf-programmes-head">
        <p class="cf-eyebrow" data-reveal>Programmes</p>
        <h2 id="cf-programmes-heading" class="cf-section-heading" data-reveal data-reveal-delay="100">
          Five tracks, one standard.
        </h2>
        <p class="cf-programmes-sub" data-reveal data-reveal-delay="200">
          Every track combines a common core, a craft module, and a final
          assessment. Additional modules on request for specific B2B needs.
        </p>
      </div>
      <ol class="cf-programmes-list">
        {programmes.map((p, i) => (
          <li
            class="cf-programme"
            data-reveal
            data-reveal-delay={String(150 + i * 90)}
            style={`--reveal-delay: ${150 + i * 90}ms;`}
          >
            <span class="cf-programme-num" aria-hidden="true">/ {String(i + 1).padStart(2, '0')}</span>
            <div class="cf-programme-text">
              <h3 class="cf-programme-name">{p.name}</h3>
              <p class="cf-programme-body">{p.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── DOMAINS (curriculum chips) ──────────────────────────── -->
  <section class="cf-section cf-domains" aria-labelledby="cf-domains-heading">
    <div class="cf-domains-frame">
      <div class="cf-domains-head">
        <p class="cf-eyebrow" data-reveal>Domains covered</p>
        <h2 id="cf-domains-heading" class="cf-section-heading" data-reveal data-reveal-delay="100">
          The curriculum, in detail.
        </h2>
      </div>
      <ul class="cf-domains-grid" aria-label="Curriculum domains covered by the training centre">
        {domains.map((d, i) => (
          <li
            class="cf-domain-chip"
            data-reveal
            data-reveal-delay={String(120 + i * 50)}
            style={`--reveal-delay: ${120 + i * 50}ms;`}
          >
            <span class="cf-domain-bullet" aria-hidden="true"></span>
            <span class="cf-domain-text">{d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── CYCLE (dark band) ───────────────────────────────────── -->
  <section class="cf-section cf-cycle" aria-labelledby="cf-cycle-heading">
    <div class="cf-cycle-frame">
      <div class="cf-cycle-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Training cycle</p>
        <h2 id="cf-cycle-heading" class="cf-section-heading cf-section-heading-on-dark" data-reveal data-reveal-delay="100">
          Four steps, no shortcuts.
        </h2>
        <p class="cf-cycle-sub" data-reveal data-reveal-delay="200">
          From the first interview to assignment, the path is legible and
          controlled. Each step is validated — or repeated.
        </p>
      </div>
      <ol class="cf-cycle-grid">
        {cycle.map((c, i) => (
          <li
            class="cf-cycle-step"
            data-reveal
            data-reveal-delay={String(150 + i * 100)}
            style={`--reveal-delay: ${150 + i * 100}ms;`}
          >
            <span class="cf-cycle-num">{c.n}</span>
            <h3 class="cf-cycle-title">{c.title}</h3>
            <p class="cf-cycle-body">{c.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ─── LOCATION ───────────────────────────────────────────── -->
  <section class="cf-section cf-locate" aria-labelledby="cf-locate-heading">
    <div class="cf-locate-frame">
      <div class="cf-locate-text">
        <p class="cf-eyebrow" data-reveal>Location</p>
        <h2 id="cf-locate-heading" class="cf-section-heading" data-reveal data-reveal-delay="100">
          The centre is open to visit, by appointment.
        </h2>
        <p class="cf-locate-sub" data-reveal data-reveal-delay="180">
          Corporate HR leads and diplomatic security desks are received on
          site — to walk the rooms, meet the instructors, and read the
          programme in detail.
        </p>
        <dl class="cf-locate-info" data-reveal data-reveal-delay="260">
          <div class="cf-locate-row">
            <dt class="cf-locate-label">Address</dt>
            <dd class="cf-locate-value">
              {trainingAddress.detail}<br />
              {trainingAddress.street}<br />
              {trainingAddress.city}, DRC
            </dd>
          </div>
          <div class="cf-locate-row">
            <dt class="cf-locate-label">Training lines</dt>
            <dd class="cf-locate-value cf-locate-phones">
              {trainingPhones.map((p) => (
                <a href={`tel:${p.tel}`}>{p.display}</a>
              ))}
            </dd>
          </div>
        </dl>
      </div>
      <div class="cf-locate-map" data-reveal data-reveal-delay="200">
        <iframe
          src="https://www.google.com/maps?q=Carrefour%20des%20Jeunes%20Victoire%20Kinshasa&z=15&output=embed"
          title="GSS training centre: Carrefour des Jeunes, Victoire, Kinshasa"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="cf-locate-map-link" href={trainingAddress.mapsUrl} target="_blank" rel="noopener noreferrer">
          Open in Google Maps
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── ENROLMENT (form) ────────────────────────────────────── -->
  <section class="cf-cta" aria-labelledby="cf-cta-heading">
    <div class="cf-cta-frame">
      <div class="cf-cta-text" data-reveal>
        <p class="cf-eyebrow cf-eyebrow-on-dark">Enrolment</p>
        <h2 id="cf-cta-heading" class="cf-cta-heading">
          Apply, or enrol your teams.
        </h2>
        <p class="cf-cta-sub">
          Individual candidates, corporate HR, diplomatic security desks.
          Upcoming cohort calendars or a dedicated session, on request.
        </p>
        <p class="cf-cta-phone">
          Or call us,
          <a href={phoneTel}>{phoneDisplay}</a>
          <span aria-hidden="true">·</span>
          <span>{contact.hours.en}</span>
        </p>
        <p class="cf-cta-wa">
          <a href={whatsappLink(waMessage)} target="_blank" rel="noopener noreferrer">
            WhatsApp,
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>

      <div class="cf-form-wrap" data-reveal data-reveal-delay="180">
        {!isConfigured && (
          <p class="cf-notice" role="status">
            <strong>Form awaiting configuration.</strong>
            WhatsApp and phone remain open in the meantime.
          </p>
        )}

        <form
          class="cf-form"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="redirect" value={`${Astro.url.origin}/en/thank-you/`} />
          <input type="hidden" name="from_name" value="GSS Congo — training enrolment" />
          <input type="hidden" name="subject" value="New training enrolment from gss-congo.com" />
          <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" />

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Full name *</span>
              <input type="text" name="name" required autocomplete="name" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Phone *</span>
              <input type="tel" name="phone" required autocomplete="tel" placeholder="+243…" />
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Email *</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>

          <div class="cf-row">
            <label class="cf-field">
              <span class="cf-label">Company (if applicable)</span>
              <input type="text" name="company" autocomplete="organization" />
            </label>
            <label class="cf-field">
              <span class="cf-label">Enrolment type</span>
              <select name="type">
                <option value="individual">Individual</option>
                <option value="team">Team (corporate HR)</option>
                <option value="diplomatic">Diplomatic security desk</option>
              </select>
            </label>
          </div>

          <label class="cf-field">
            <span class="cf-label">Programme</span>
            <select name="programme">
              <option value="">— Choose a programme —</option>
              <option value="Prevention & security agent">Prevention &amp; security agent</option>
              <option value="Fire safety & first aid">Fire safety &amp; first aid</option>
              <option value="Canine handler & K9">Canine handler &amp; K9</option>
              <option value="Defensive driving & escort">Defensive driving &amp; escort</option>
              <option value="Protocol & elite security">Protocol &amp; elite security</option>
              <option value="other">Other / to discuss</option>
            </select>
          </label>

          <label class="cf-field">
            <span class="cf-label">A few words about your context</span>
            <textarea name="message" rows="4" placeholder="Availability, headcount to train, constraints…"></textarea>
          </label>

          <p class="cf-fineprint">
            Your information stays confidential and is used only to process
            your enrolment.
          </p>

          <div class="cf-actions">
            <NeonButton type="submit" variant="solid" size="lg">
              Send my enrolment
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </NeonButton>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: saturate(0.88);
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, oklch(8% 0.03 250 / 0.32) 0%, oklch(8% 0.03 250 / 0.55) 55%, oklch(8% 0.03 250 / 0.92) 100%),
      radial-gradient(80% 50% at 30% 90%, oklch(40% 0.06 70 / 0.20), transparent 70%);
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 40em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-section {
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.75rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── MANIFESTO ────────────────────────────────────────────── */
  .cf-manifest {
    background: var(--color-cream);
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .cf-manifest-frame { max-width: 920px; margin-inline: auto; }
  .cf-manifest-text {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 420, 'SOFT' 40;
    font-size: clamp(1.5rem, 2.8vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* ─── PROGRAMMES ───────────────────────────────────────────── */
  .cf-programmes { background: var(--color-cream-2); }
  .cf-programmes-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (min-width: 1024px) {
    .cf-programmes-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
      align-items: start;
    }
  }
  .cf-programmes-head { max-width: 30rem; }
  .cf-programmes-sub {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
  }
  .cf-programmes-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .cf-programme {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-hairline-on-light);
    align-items: baseline;
  }
  .cf-programme:last-child { border-bottom: 1px solid var(--color-hairline-on-light); }
  .cf-programme-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.9375rem;
    color: var(--color-bronze);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    padding-top: 0.25rem;
  }
  .cf-programme-text { display: flex; flex-direction: column; gap: 0.5rem; }
  .cf-programme-name {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .cf-programme-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 38em;
  }

  /* ─── DOMAINS (chips) ──────────────────────────────────────── */
  .cf-domains { background: var(--color-cream); }
  .cf-domains-frame { max-width: 1280px; margin-inline: auto; }
  .cf-domains-head { max-width: 36rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .cf-domains-grid {
    list-style: none; margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 0.75rem;
  }
  .cf-domain-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem 0.625rem 0.875rem;
    border: 1px solid var(--color-hairline-on-light);
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-ink);
    background: var(--color-cream-2);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      background-color var(--duration-normal) var(--ease-out-expo);
  }
  .cf-domain-chip:hover {
    border-color: var(--color-bronze);
    background: var(--color-cream);
  }
  .cf-domain-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-bronze);
    flex-shrink: 0;
  }

  /* ─── CYCLE (dark band) ────────────────────────────────────── */
  .cf-cycle {
    background: var(--color-ink);
    color: var(--color-cream);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cf-cycle::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(60% 60% at 90% 10%, oklch(40% 0.06 70 / 0.22), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  .cf-cycle-frame { max-width: 1280px; margin-inline: auto; }
  .cf-cycle-head { max-width: 44rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .cf-cycle-sub {
    margin: 1.25rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-cream);
    opacity: 0.78;
    max-width: 36em;
  }
  .cf-cycle-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) { .cf-cycle-grid { grid-template-columns: repeat(4, 1fr); } }
  .cf-cycle-step {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 1.75rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.10);
    border-right: 1px solid oklch(100% 0 0 / 0.10);
  }
  @media (min-width: 1024px) {
    .cf-cycle-step { border-bottom: none; }
    .cf-cycle-step:last-child { border-right: none; }
  }
  @media (max-width: 1023px) {
    .cf-cycle-step:nth-child(2n) { border-right: none; }
    .cf-cycle-step:nth-last-child(-n+2) { border-bottom: none; }
  }
  .cf-cycle-num {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 0.875rem;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }
  .cf-cycle-title {
    margin: 1rem 0 0.75rem;
