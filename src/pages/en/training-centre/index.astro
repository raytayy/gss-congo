---
/*
 * /en/training-centre/ — Training centre (EN). Mirror of /fr/centre-de-formation/.
 * Info-only page. Inscription happens on /en/candidate-space/.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import NeonButton from '@components/NeonButton.astro';
import { educationalOrgSchema, breadcrumbSchema, courseSchema } from '@lib/jsonld';
import { contact } from '@lib/contact';

const siteUrl = Astro.site?.toString() ?? 'https://gss-congo.com/';
const trainingAddr = contact.addresses.training;
const trainingMapEmbed =
  'https://www.google.com/maps?q=5151+avenue+Kasavubu+Kalamu+Kinshasa&z=16&output=embed';

// Five training programmes (cursus) visible on the page — mirror those
// declared in educationalOrgSchema(). One Course schema per programme.
const cursus = [
  {
    courseCode: 'GSS-FORMATION-AGENT',
    name: 'Prevention and security agent',
    description: 'Common core. Legal framework, access control, posture, radio communication, conflict management.',
  },
  {
    courseCode: 'GSS-FORMATION-INCENDIE',
    name: 'Fire safety & first aid',
    description: 'SSIAP-style modules: fire prevention, evacuation, extinguisher handling, life-saving gestures.',
  },
  {
    courseCode: 'GSS-FORMATION-K9',
    name: 'Canine handler & K9',
    description: 'Paired work with a response dog: training, commands, behavioural reading, supervised deterrence.',
  },
  {
    courseCode: 'GSS-FORMATION-CONDUITE',
    name: 'Defensive driving & escort',
    description: 'Route study, anticipation, driving under pressure, convoy coordination, posture in incidents.',
  },
  {
    courseCode: 'GSS-FORMATION-PROTOCOLE',
    name: 'Protocol & elite security',
    description: 'Civilian dress, diplomatic etiquette, discreet earpiece, room reading, VIP movements.',
  },
];

// Visible FAQ items (also emitted as FAQPage schema below).
const faqItems = [
  {
    q: 'How long is the training?',
    a: 'The "Prevention and security agent" common core runs about eight weeks, followed by specialty modules (fire, K9, defensive driving, protocol) depending on the programme chosen.',
  },
  {
    q: 'Do I need a prior qualification?',
    a: 'No specific qualification is required. We check spoken French proficiency, baseline physical condition, and the absence of a history incompatible with the role.',
  },
  {
    q: 'Does the centre train agents from other companies?',
    a: 'Yes, on request. The centre hosts trainees from other security companies, embassies and private operators for sessions calibrated to their needs.',
  },
  {
    q: 'Is there certification at the end of training?',
    a: 'Each programme ends with a practical and theoretical evaluation. Agents receive an internal GSS certificate recognised by our clients and partners.',
  },
];

const jsonLd = [
  educationalOrgSchema('en', siteUrl),
  breadcrumbSchema(
    [
      { name: 'Home', path: '/en/' },
      { name: 'Training centre', path: '/en/training-centre/' },
    ],
    siteUrl,
  ),
  ...cursus.map((c) => courseSchema('en', siteUrl, c.name, c.description, c.courseCode)),
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: 'en-CD',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="Security training centre in Kinshasa"
  description="GSS Congo security agent training centre in Kinshasa. Five programmes: legal framework, fire safety, K9, defensive driving, VIP protocol."
  lang="en"
  altLocaleHref="/fr/centre-de-formation/"
  jsonLd={jsonLd}
>
  <!-- ─── HERO ────────────────────────────────────────────────── -->
  <section class="cf-hero" aria-labelledby="cf-heading">
    <div class="cf-hero-image" aria-hidden="true">
      <img src="/images/formation-hero.jpg" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="cf-hero-overlay"></div>
    </div>
    <div class="cf-hero-content">
      <p class="cf-eyebrow cf-eyebrow-on-dark" data-reveal>Training centre</p>
      <h1 id="cf-heading" class="cf-hero-title" data-reveal data-reveal-delay="120">
        Our agents are not recruited. They are trained.
      </h1>
      <p class="cf-hero-intro" data-reveal data-reveal-delay="240">
        If you're driven by a long-term career, join the GSS training centre.
        Our new training centre prepares you for a respected and, above all,
        safe career. Our security agent training in Kinshasa is designed to
        give you the skills and knowledge needed to become a qualified, more
        than competent security agent.
      </p>
      <div class="cf-hero-actions" data-reveal data-reveal-delay="360">
        <NeonButton variant="solid" size="lg" href="/en/candidate-space/">
          Enrol
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </NeonButton>
      </div>
    </div>
  </section>

  <!-- ─── VIDEO — scroll-scrub showcase (full-bleed expansion) ──── -->
  <section class="cf-showcase" aria-labelledby="cf-video-heading" data-showcase>
    <div class="cf-showcase-sticky">
      <div class="cf-showcase-head">
        <p class="cf-eyebrow cf-eyebrow-on-dark">In video</p>
        <h2 id="cf-video-heading" class="cf-showcase-heading">
          The training centre, in motion.
        </h2>
      </div>
      <div class="cf-showcase-media">
        <video
          muted
          loop
          playsinline
          preload="none"
          poster="/images/formation-promo-poster.jpg"
          width="640"
          height="426"
          data-showcase-video
        >
          <source src="/videos/formation-promo.mp4" type="video/mp4" />
        </video>
        <button
          class="cf-showcase-sound"
          type="button"
          aria-label="Turn sound on"
          data-sound-toggle
          data-label-on="Turn sound on"
          data-label-off="Mute sound"
        >
          <svg class="ico-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M11 5 6 9H3v6h3l5 4V5Z" stroke-linejoin="round" />
            <path d="m16 9 5 6M21 9l-5 6" stroke-linecap="round" />
          </svg>
          <svg class="ico-sound" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M11 5 6 9H3v6h3l5 4V5Z" stroke-linejoin="round" />
            <path d="M15.5 9.5a4 4 0 0 1 0 5M18 7a7.5 7.5 0 0 1 0 10" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <script is:inline>
    // Scroll-scrub showcase — see FR sibling for the annotated version.
    (function () {
      if (window.__gssShowcaseBound) return;
      window.__gssShowcaseBound = true;

      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ticking = false;

      function update() {
        ticking = false;
        var section = document.querySelector('[data-showcase]');
        if (!section) return;
        var rect = section.getBoundingClientRect();
        var runway = rect.height - window.innerHeight;
        if (runway <= 0) return;
        var p = Math.min(1, Math.max(0, -rect.top / runway));
        section.style.setProperty('--p', p.toFixed(4));
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      function bindVideo() {
        var video = document.querySelector('[data-showcase-video]');
        if (!video || video.dataset.bound === '1') return;
        video.dataset.bound = '1';

        var media = video.closest('.cf-showcase-media');
        function markState() {
          if (media) media.classList.toggle('is-paused', video.paused);
        }
        video.addEventListener('play', markState);
        video.addEventListener('pause', markState);

        function tryPlay() {
          var pr = video.play();
          if (pr && pr.catch) pr.catch(function () { markState(); });
        }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              tryPlay();
            } else {
              video.pause();
            }
          });
        }, { threshold: 0.15 });
        io.observe(video);

        video.addEventListener('click', function () {
          if (video.paused) tryPlay();
          else video.pause();
        });
        markState();

        var btn = document.querySelector('[data-sound-toggle]');
        if (btn) {
          btn.addEventListener('click', function () {
            video.muted = !video.muted;
            btn.classList.toggle('is-sound-on', !video.muted);
            btn.setAttribute(
              'aria-label',
              video.muted
                ? btn.dataset.labelOn || 'Turn sound on'
                : btn.dataset.labelOff || 'Mute sound'
            );
          });
        }
      }

      function init() {
        bindVideo();
        if (!reduced) {
          update();
        }
      }

      if (!reduced) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
      init();
      document.addEventListener('astro:page-load', init);
    })();
  </script>

  <!-- ─── PRACTICAL TRAINING — block 1 (image left, text right) ── -->
  <section class="cf-practical" aria-labelledby="cf-practical-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/formation-1.jpg"
          alt="Full GSS team in formation before the house emblem — a graduating cohort of the centre"
          loading="lazy"
          decoding="async"
          width="900"
          height="1000"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Practice</p>
        <h2 id="cf-practical-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Not just theory.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          GSS security agent training isn't limited to theory. A quality
          training centre offers opportunities to gain practical experience
          through real-world drills. You'll face simulated scenarios where
          you'll need to make quick decisions, manage conflicts and apply
          the right security procedures. This hands-on experience will
          effectively prepare you for the demands of the field and help you
          build your confidence and your skill. Our team of experienced
          professional instructors will provide hands-on training to help
          you develop your skills and feel confident in your future role as
          a security agent.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── CONVICTION — block 2 (image right, text left) ───────── -->
  <section class="cf-practical cf-practical-flip" aria-labelledby="cf-conviction-heading">
    <div class="cf-practical-frame">
      <figure class="cf-practical-media" data-reveal>
        <img
          src="/images/formation/formation-2.jpg"
          alt="GSS agent in front of the training centre — GSS Centre de Formation facade at night"
          loading="lazy"
          decoding="async"
          width="900"
          height="1000"
        />
        <div class="cf-practical-tone" aria-hidden="true"></div>
      </figure>
      <div class="cf-practical-text">
        <p class="cf-eyebrow" data-reveal>Commitment</p>
        <h2 id="cf-conviction-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Your best shot at success.
        </h2>
        <p class="cf-practical-body" data-reveal data-reveal-delay="240">
          At GSS, we are convinced that our professional training programme
          will give you the best chance of succeeding in your career as a
          security agent. So don't wait any longer.
        </p>
        <div class="cf-practical-cta" data-reveal data-reveal-delay="360">
          <NeonButton variant="solid" size="lg" href="/en/candidate-space/">
            Enrol
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </NeonButton>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── VISIT — address + embedded map ──────────────────────── -->
  <section class="cf-visit" aria-labelledby="cf-visit-heading">
    <div class="cf-visit-frame">
      <div class="cf-visit-text">
        <p class="cf-eyebrow" data-reveal>Visit</p>
        <h2 id="cf-visit-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
          Find us.
        </h2>
        <address class="cf-visit-address" data-reveal data-reveal-delay="200">
          <span class="cf-visit-line cf-visit-line-strong">{trainingAddr.street}</span>
          <span class="cf-visit-line">Kalamu — Ref. Carrefour des Jeunes</span>
          <span class="cf-visit-line">{trainingAddr.city}, Democratic Republic of the Congo</span>
        </address>
        <p class="cf-visit-cta" data-reveal data-reveal-delay="280">
          <a href={trainingAddr.mapsUrl} target="_blank" rel="noopener noreferrer">
            Get directions
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
      <div class="cf-visit-map" data-reveal data-reveal-delay="200">
        <iframe
          src={trainingMapEmbed}
          title="GSS training centre — 5151, avenue Kasavubu, Kalamu, Kinshasa"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ─── FAQ — visible block ──────────────────────────────────── -->
  <section class="cf-faq" aria-labelledby="cf-faq-heading">
    <div class="cf-faq-frame">
      <p class="cf-eyebrow" data-reveal>Frequently asked</p>
      <h2 id="cf-faq-heading" class="cf-section-heading" data-reveal data-reveal-delay="120">
        Your questions about the training.
      </h2>
      <ul class="cf-faq-list">
        {faqItems.map((item, i) => (
          <li
            class="cf-faq-item"
            data-reveal
            data-reveal-delay={String(200 + i * 80)}
            style={`--reveal-delay: ${200 + i * 80}ms;`}
          >
            <details class="cf-faq-details">
              <summary class="cf-faq-question">{item.q}</summary>
              <p class="cf-faq-answer">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── HERO ─────────────────────────────────────────────────── */
  .cf-hero {
    position: relative;
    min-height: clamp(34rem, 78vh, 46rem);
    display: flex;
    align-items: flex-end;
    color: var(--color-cream);
    overflow: hidden;
    padding: clamp(8rem, 16vw, 14rem) clamp(1.5rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .cf-hero-image { position: absolute; inset: 0; z-index: -1; }
  .cf-hero-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    animation: cf-ken-burns 26s ease-out 0.4s forwards;
  }
  @keyframes cf-ken-burns {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-hero-overlay {
    position: absolute; inset: 0;
    background: none;
  }
  .cf-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
  }
  .cf-hero-title {
    margin: 1rem 0 1.5rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 420, 'SOFT' 50;
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-cream);
    max-width: 16em;
    text-wrap: balance;
  }
  .cf-hero-intro {
    margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-cream);
    max-width: 44em;
    opacity: 0.92;
  }

  /* ─── SHARED CHROME ────────────────────────────────────────── */
  .cf-eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cf-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .cf-eyebrow-on-dark { color: var(--color-bronze-warm); }
  .cf-eyebrow-on-dark::before { background: var(--color-bronze-warm); }
  .cf-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.875rem, 3.4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    max-width: 18em;
    text-wrap: balance;
  }
  .cf-section-heading-on-dark { color: var(--color-cream); }

  /* ─── PRACTICAL (image + paragraph) ────────────────────────── */
  .cf-practical {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
  }
  .cf-practical-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cf-practical-frame {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
    }
  }
  .cf-practical-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-practical-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: saturate(0.94);
    animation: cf-practical-zoom 26s ease-out 0.6s forwards;
    will-change: transform;
  }
  @keyframes cf-practical-zoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.08); }
  }
  .cf-practical-tone {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 60%, oklch(15% 0.04 250 / 0.25) 100%),
      radial-gradient(60% 50% at 10% 100%, oklch(22% 0.06 70 / 0.18), transparent 65%);
    pointer-events: none;
  }
  .cf-practical-text { display: flex; flex-direction: column; }
  .cf-practical-body {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }
  .cf-practical-cta {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Alternating layout: 2nd block puts the image on the right (desktop). */
  @media (min-width: 1024px) {
    .cf-practical-flip .cf-practical-frame {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
    .cf-practical-flip .cf-practical-media { order: 2; }
    .cf-practical-flip .cf-practical-text { order: 1; }
  }
  .cf-practical-flip { background: var(--color-cream-2); }

  @media (prefers-reduced-motion: reduce) {
    .cf-hero-image img,
    .cf-practical-media img { animation: none; }
  }

  /* ─── VISIT (address + embedded map) ───────────────────────── */
  .cf-visit {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-hairline-on-light);
  }
  .cf-visit-frame {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .cf-visit-frame {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 4.5rem;
      align-items: center;
    }
  }
  .cf-visit-text { display: flex; flex-direction: column; }
  .cf-visit-address {
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.55;
    color: var(--color-mute-on-light);
  }
  .cf-visit-line-strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'wght' 460;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .cf-visit-cta {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 0;
    font-size: 0.9375rem;
  }
  .cf-visit-cta a {
    color: var(--color-bronze-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline-on-light);
    padding-bottom: 0.15rem;
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cf-visit-cta a:hover {
    color: var(--color-bronze);
    border-bottom-color: var(--color-bronze);
  }
  .cf-visit-map {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-cream-2);
    box-shadow:
      0 1px 2px oklch(0% 0 0 / 0.04),
      0 22px 48px -18px oklch(20% 0.04 250 / 0.22);
  }
  .cf-visit-map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.35) saturate(0.92);
    transition: filter var(--duration-slow) var(--ease-out-expo);
  }
  .cf-visit-map:hover iframe { filter: grayscale(0) saturate(1); }

  /* ─── Hero CTA ─────────────────────────────────────────────── */
  .cf-hero-actions {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* ─── FAQ ──────────────────────────────────────────────────── */
  .cf-faq {
    background: var(--color-cream-2);
    color: var(--color-ink);
    padding: clamp(5rem, 11vw, 10rem) clamp(1.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-hairline-on-light);
  }
  .cf-faq-frame {
    max-width: 920px;
    margin-inline: auto;
  }
