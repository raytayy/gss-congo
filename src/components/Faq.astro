---
/*
 * Faq — native <details>/<summary> accordion. No JS required.
 * Used on contact page; can be reused on service-detail or services hub.
 */

import type { Locale } from '@lib/i18n';
import { faqItems as items } from '@lib/faq';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const eyebrow = locale === 'fr' ? 'Questions fréquentes' : 'Frequent questions';
const heading = locale === 'fr'
  ? 'Avant l’échange, les questions qui reviennent.'
  : 'Before the call, the questions that come back.';
---

<section class="faq" aria-labelledby="faq-heading">
  <div class="faq-frame">
    <header class="faq-header" data-reveal>
      <p class="faq-eyebrow">{eyebrow}</p>
      <h2 id="faq-heading" class="faq-heading">{heading}</h2>
    </header>

    <div class="faq-list" role="list">
      {items.map((item, i) => (
        <details class="faq-item" role="listitem" data-reveal data-reveal-delay={String(80 * i)}>
          <summary class="faq-summary">
            <span class="faq-q">{item.q[locale]}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{item.a[locale]}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--color-cream-2);
    color: var(--color-ink);
    padding: clamp(3.5rem, 12vw, 11rem) clamp(1.5rem, 5vw, 4rem);
    border-block: 1px solid var(--color-hairline-on-light);
  }
  .faq-frame {
    max-width: 880px;
    margin-inline: auto;
  }
  .faq-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .faq-eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .faq-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .faq-heading {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(1.875rem, 3.4vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .faq-list {
    border-top: 1px solid var(--color-hairline-on-light);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-hairline-on-light);
  }
  .faq-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.25rem, 2vw, 1.75rem) 0;
    user-select: none;
  }
  .faq-summary::-webkit-details-marker { display: none; }
  .faq-q {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.3;
    color: var(--color-ink);
    letter-spacing: -0.005em;
  }
  .faq-icon {
    flex-shrink: 0;
    color: var(--color-bronze-deep);
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }
  .faq-icon svg { width: 1.125rem; height: 1.125rem; }
  .faq-item[open] .faq-icon { transform: rotate(180deg); }

  .faq-answer {
    padding: 0 0 clamp(1.25rem, 2vw, 1.75rem);
    max-width: 60ch;
  }
  .faq-answer p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-mute-on-light);
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--color-bronze-deep);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
