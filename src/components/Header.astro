---
/*
 * Header — site navigation.
 * Desktop: logo · 5 nav items · phone · lang switch · Devis CTA.
 * Mobile: logo · WhatsApp · hamburger → slide-in panel.
 * Transparent over hero, frosted ink past 80px scroll (CSS + small island).
 */

import Logo from './Logo.astro';
import NeonButton from './NeonButton.astro';
import { ui, t, getAltLocaleHref, type Locale } from '@lib/i18n';
import { contact } from '@lib/contact';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const altLocale: Locale = locale === 'fr' ? 'en' : 'fr';
const altLocaleHref = getAltLocaleHref(currentPath, locale);

const navItems = [
  { label: t(ui.nav.services, locale), href: `/${locale}/services/` },
  { label: t(ui.nav.about, locale), href: `/${locale}/${locale === 'fr' ? 'a-propos' : 'about'}/` },
  { label: t(ui.nav.formation, locale), href: `/${locale}/${locale === 'fr' ? 'centre-de-formation' : 'training-centre'}/` },
  { label: t(ui.nav.careers, locale), href: `/${locale}/${locale === 'fr' ? 'carrieres' : 'careers'}/` },
  { label: t(ui.nav.news, locale), href: `/${locale}/${locale === 'fr' ? 'actualites' : 'news'}/` },
];

const contactHref = `/${locale}/contact/`;
---

<header class="site-header" data-scroll-state="top">
  <div class="header-inner container-content">
    <Logo size="md" variant="on-light" href={`/${locale}/`} />

    <nav class="nav-desktop" aria-label={locale === 'fr' ? 'Navigation principale' : 'Primary navigation'}>
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a class="nav-link" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-end">
      <a class="header-phone" href={`tel:${contact.phones.primary.tel}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 5.5C3 4.12 4.12 3 5.5 3h1.4c.7 0 1.3.5 1.5 1.2l.7 2.8c.2.7-.1 1.4-.7 1.8L7 9.5c1.4 2.6 3.5 4.7 6 6l.7-1.5c.4-.6 1.1-.9 1.8-.7l2.8.7c.7.2 1.2.8 1.2 1.5v1.4c0 1.4-1.1 2.6-2.5 2.6C9 19.5 4.5 15 4.5 7.5 4.5 6 3 5.5 3 5.5Z" stroke-linejoin="round" />
        </svg>
        <span class="header-phone-display">{contact.phones.primary.display}</span>
      </a>

      <NeonButton
        variant="default"
        size="sm"
        neon={false}
        href={altLocaleHref}
        ariaLabel={t(ui.a11y.languageSwitch, locale)}
        class="header-lang"
      >
        {altLocale.toUpperCase()}
      </NeonButton>

      <NeonButton variant="solid" size="sm" href={contactHref}>
        {t(ui.cta.quoteShort, locale)}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </NeonButton>
    </div>

    <button
      class="mobile-toggle"
      aria-label={t(ui.a11y.openMenu, locale)}
      aria-expanded="false"
      aria-controls="mobile-panel"
      data-mobile-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  {/* Mobile panel — full-screen when toggled */}
  <div class="mobile-panel" id="mobile-panel" data-mobile-panel hidden>
    <div class="mobile-panel-bar">
      <Logo size="md" variant="on-light" href={`/${locale}/`} />
      <button
        class="mobile-close"
        type="button"
        aria-label={locale === 'fr' ? 'Fermer le menu' : 'Close menu'}
        data-mobile-close
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 6 18 18M18 6 6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <nav aria-label={locale === 'fr' ? 'Navigation mobile' : 'Mobile navigation'}>
      <ul class="mobile-nav-list">
        <li>
          <a class="mobile-nav-link" href={`/${locale}/`}>
            {locale === 'fr' ? 'Accueil' : 'Home'}
          </a>
        </li>
        {navItems.map((item) => (
          <li><a class="mobile-nav-link" href={item.href}>{item.label}</a></li>
        ))}
        <li><a class="mobile-nav-link" href={contactHref}>{t(ui.nav.contact, locale)}</a></li>
      </ul>
      <div class="mobile-footer">
        <a class="mobile-phone" href={`tel:${contact.phones.primary.tel}`}>
          {contact.phones.primary.display}
        </a>
        <a class="mobile-lang" href={altLocaleHref}>
          {t(ui.language[altLocale], locale)}
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // is:inline + astro:page-load: rebinds after every view transition.
  // Without it, the toggle button stops working once you navigate away
  // and come back (the new DOM has no listeners attached).
  function setupHeader() {
    const toggle = document.querySelector('[data-mobile-toggle]');
    const panel = document.querySelector('[data-mobile-panel]');
    const closeBtn = document.querySelector('[data-mobile-close]');
    const header = document.querySelector('.site-header');

    if (toggle && panel) {
      const open = () => {
        toggle.setAttribute('aria-expanded', 'true');
        panel.removeAttribute('hidden');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        toggle.setAttribute('aria-expanded', 'false');
        panel.setAttribute('hidden', '');
        document.body.style.overflow = '';
      };
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        if (expanded) close(); else open();
      });
      if (closeBtn) closeBtn.addEventListener('click', close);
      // Tapping a nav link should also close the panel.
      panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
      // ESC closes the panel.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') close();
      });
    }

    if (header) {
      const update = () => {
        header.dataset.scrollState = window.scrollY > 24 ? 'scrolled' : 'top';
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
    }
  }
  // Initial page load: call directly. The script sits below </header>,
  // so the toggle DOM is already parsed. Mobile especially needs this —
  // astro:page-load can fire before the listener is registered.
  setupHeader();
  // Subsequent view-transition navigations: rebind on the new DOM.
  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    /* Always carry a faint cream scrim so the ink-coloured nav stays
       readable over dark hero plates (home, careers, training centre).
       The scrim intensifies once the user scrolls past the hero. */
    background-color: rgba(245, 240, 230, 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition: background-color var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo);
    border-bottom: 1px solid transparent;
  }
  .site-header[data-scroll-state='scrolled'] {
    background-color: rgba(245, 240, 230, 0.94);
    border-bottom-color: var(--color-hairline-on-light);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 1rem;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .nav-desktop {
    display: none;
  }
  @media (min-width: 1024px) {
    .nav-desktop {
      display: block;
      flex: 1;
    }
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .nav-link {
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    position: relative;
    padding-block: 0.25rem;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-bronze);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .header-end {
    display: none;
    align-items: center;
    gap: 1rem;
    margin-left: auto;
  }
  @media (min-width: 1024px) {
    .header-end {
      display: flex;
    }
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-mute-on-light);
    font-size: 0.875rem;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: color var(--duration-normal) var(--ease-out-expo);
  }
  .header-phone:hover { color: var(--color-ink); }
  .header-phone svg { width: 1rem; height: 1rem; }

  .lang-switch a {
    display: inline-block;
    padding: 0.5rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    text-decoration: none;
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-xs);
    transition: all var(--duration-normal) var(--ease-out-expo);
  }
  .lang-switch a:hover {
    border-color: var(--color-bronze);
    color: var(--color-bronze);
  }

  .mobile-toggle {
    display: inline-grid;
    place-items: center;
    margin-left: auto;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
    cursor: pointer;
  }
  .mobile-toggle svg { width: 1.4rem; height: 1.4rem; }
  @media (min-width: 1024px) {
    .mobile-toggle { display: none; }
  }

  .mobile-panel {
    position: fixed;
    inset: 0;
    background: var(--color-cream);
    padding: 0 1.5rem 2rem;
    overflow-y: auto;
    z-index: 110;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 1024px) {
    .mobile-panel { display: none !important; }
  }

  /* Panel header — logo (left) + close button (right) */
  .mobile-panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-hairline-on-light);
  }
  .mobile-close {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: transparent;
    border: 1px solid var(--color-hairline-on-light);
    border-radius: var(--radius-xs);
    color: var(--color-ink);
    cursor: pointer;
    transition: border-color var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo);
  }
  .mobile-close:hover,
  .mobile-close:focus-visible {
    border-color: var(--color-bronze);
    color: var(--color-bronze-deep);
  }
  .mobile-close svg { width: 1.4rem; height: 1.4rem; }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .mobile-nav-link {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-size: 1.75rem;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-hairline-on-light);
  }

  .mobile-footer {
    margin-top: 2rem;
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .mobile-phone {
    color: var(--color-bronze);
    font-weight: 500;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .mobile-lang {
    color: var(--color-mute-on-light);
    font-size: 0.875rem;
    text-decoration: none;
    border: 1px solid var(--color-hairline-on-light);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
  }
</style>
