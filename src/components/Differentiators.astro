---
/*
 * Differentiators — three-promise positioning rail.
 * Bridges "who we serve" (Industries) → "how we work" (Method) by stating
 * what makes the firm distinct in three bound promises (continuity, local
 * training, contractual SLA). Facts are derived from BRAND.md / contact lib.
 */

import type { Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

interface Promise {
  metric: { fr: string; en: string };
  title: { fr: string; en: string };
  body: { fr: string; en: string };
}

const promises: Promise[] = [
  {
    metric: { fr: '11 ans', en: '11 years' },
    title: { fr: 'Sans interruption', en: 'Uninterrupted' },
    body: {
      fr: 'Établis en 2014. Aucun mandat suspendu, aucune équipe dispersée. La continuité d’une posture est la première promesse que nous tenons.',
      en: 'Established in 2014. No mandate suspended, no team dispersed. The first promise we keep is the continuity of a posture.',
    },
  },
  {
    metric: { fr: '300 agents', en: '300 agents' },
    title: { fr: 'Formés sur place', en: 'Locally trained' },
    body: {
      fr: 'Notre centre de formation, à Kinshasa, calibre chaque agent au contexte congolais. Pas d’intérim importé. Pas de standard générique.',
      en: 'Our training centre, in Kinshasa, calibrates every agent to the Congolese context. No imported staffing. No generic standard.',
    },
  },
  {
    metric: { fr: '< 20 min', en: '< 20 min' },
    title: { fr: 'Contractuel', en: 'Contractual' },
    body: {
      fr: 'Le délai d’intervention est inscrit au contrat, pas dans une plaquette. Mesuré, audité, tenu — sans formule d’atténuation.',
      en: 'Response time is in the contract, not in a brochure. Measured, audited, held — without softening clauses.',
    },
  },
];

const eyebrow = locale === 'fr' ? 'Pourquoi nous' : 'Why us';
const heading = locale === 'fr' ? '3 promesses tenues.' : '3 promises kept.';
const sub = locale === 'fr'
  ? 'Notre différence ne tient pas dans un slogan. Elle tient dans ce que nous nous engageons, par écrit, à maintenir.'
  : 'Our difference isn’t in a slogan. It’s in what we commit, in writing, to maintain.';
---

<section class="differentiators" aria-labelledby="differentiators-heading">
  <div class="differentiators-frame">
    <header class="differentiators-header" data-reveal>
      <p class="differentiators-eyebrow">{eyebrow}</p>
      <h2 id="differentiators-heading" class="differentiators-heading">{heading}</h2>
      <p class="differentiators-sub">{sub}</p>
    </header>

    <ul class="differentiators-grid">
      {promises.map((p, i) => (
        <li class="promise glow-card" data-glow-tone="light" data-reveal data-reveal-delay={String(120 + i * 90)}>
          <span class="promise-metric">{p.metric[locale]}</span>
          <h3 class="promise-title">{p.title[locale]}</h3>
          <p class="promise-body">{p.body[locale]}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .differentiators {
    background: var(--color-cream-2);
    color: var(--color-ink);
    padding: clamp(3.5rem, 12vw, 11rem) clamp(1.5rem, 5vw, 4rem);
    border-block: 1px solid var(--color-hairline-on-light);
  }
  .differentiators-frame {
    max-width: 1440px;
    margin-inline: auto;
  }
  .differentiators-header {
    max-width: 38em;
    margin-bottom: clamp(2.5rem, 4vw, 4rem);
  }
  .differentiators-eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-bronze-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .differentiators-eyebrow::before {
    content: '';
    display: inline-block;
    width: 2.5rem;
    height: 1px;
    background: var(--color-bronze-deep);
  }
  .differentiators-heading {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 440, 'SOFT' 30;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .differentiators-sub {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-mute-on-light);
    max-width: 36em;
  }

  .differentiators-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-hairline-on-light);
  }
  @media (min-width: 768px) {
    .differentiators-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .promise {
    padding: clamp(2rem, 3.5vw, 2.75rem) clamp(1.5rem, 2.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-bottom: 1px solid var(--color-hairline-on-light);
  }
  @media (min-width: 768px) {
    .promise { border-bottom: 0; border-right: 1px solid var(--color-hairline-on-light); }
    .promise:last-child { border-right: 0; }
  }
  @media (max-width: 767px) {
    .promise:last-child { border-bottom: 0; }
  }

  .promise-metric {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 380, 'SOFT' 80;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-bronze-deep);
    font-variant-numeric: tabular-nums lining-nums;
    text-wrap: balance;
  }

  .promise-title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink);
    font-weight: 500;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-bronze-deep);
    align-self: flex-start;
  }

  .promise-body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-mute-on-light);
    max-width: 28em;
  }
</style>
