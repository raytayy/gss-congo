---
/*
 * MobileActionBar — sticky bottom action bar (mobile + tablet only).
 * Premium app pattern. Materially lifts conversion on mobile audiences (P3, P4, P5).
 * Three equal-width cells: Appeler · WhatsApp · Devis.
 */

import { contact, whatsappLink } from '@lib/contact';
import { ui, t, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<aside class="mobile-action-bar" aria-label={locale === 'fr' ? 'Actions rapides' : 'Quick actions'}>
  <a class="mab-cell" href={`tel:${contact.phones.primary.tel}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M3 5.5C3 4.12 4.12 3 5.5 3h1.4c.7 0 1.3.5 1.5 1.2l.7 2.8c.2.7-.1 1.4-.7 1.8L7 9.5c1.4 2.6 3.5 4.7 6 6l.7-1.5c.4-.6 1.1-.9 1.8-.7l2.8.7c.7.2 1.2.8 1.2 1.5v1.4c0 1.4-1.1 2.6-2.5 2.6C9 19.5 4.5 15 4.5 7.5 4.5 6 3 5.5 3 5.5Z" stroke-linejoin="round" />
    </svg>
    <span>{t(ui.cta.call, locale)}</span>
  </a>

  <a class="mab-cell mab-divider" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 19l1.4-3.5A8 8 0 1 1 9 18l-4 1Z" stroke-linejoin="round" stroke-linecap="round" />
      <path d="M9 10c.3 1 .8 1.7 1.6 2.4.7.6 1.6 1.1 2.4 1.4l1-1.2c.3-.3.7-.4 1.1-.2l1.7.6c.3.1.5.4.5.7v1c0 .8-.7 1.4-1.4 1.3-3.7-.3-6.6-3.2-7-6.9 0-.7.5-1.4 1.3-1.4h1c.3 0 .6.2.7.5l.6 1.7c.2.4.1.8-.2 1.1L9 10Z" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
    <span>{t(ui.cta.whatsapp, locale)}</span>
  </a>

  <a class="mab-cell mab-cta" href={`/${locale}/contact/`}>
    <span>{t(ui.cta.quoteShort, locale)}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </a>
</aside>

<style>
  .mobile-action-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    background: var(--color-ink);
    color: var(--color-cream);
    border-top: 1px solid var(--color-hairline-on-dark);
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
  @media (min-width: 1024px) {
    .mobile-action-bar { display: none; }
  }

  .mab-cell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 0.5rem;
    color: inherit;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    min-height: 56px;
    transition: background-color var(--duration-fast) var(--ease-out-expo);
  }
  .mab-cell:active {
    background-color: var(--color-ink-2);
  }
  .mab-cell svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .mab-divider {
    border-inline: 1px solid var(--color-hairline-on-dark);
  }

  .mab-cta {
    background: var(--color-bronze);
    color: var(--color-ink);
  }
  .mab-cta:active {
    background: var(--color-bronze-deep);
  }
</style>
