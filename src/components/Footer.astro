---
/*
 * Footer — institutional 4-column footer with rounded-top + radial highlight.
 * Pattern adapted from the React footer-section component (motion → CSS-only
 * via [data-reveal], lucide icons → existing inline social SVGs).
 *
 * Columns: Identity (logo + tagline + copyright + social) /
 *          L'entreprise (Services link + nav) /
 *          Légal (mentions/privacy/cookies) /
 *          Coordonnées (HQ + training centre + phone/email + hours).
 */

import Logo from './Logo.astro';
import { ui, t, type Locale } from '@lib/i18n';
import { contact } from '@lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

const companyLinks = [
  { label: t(ui.nav.services, locale), href: `/${locale}/services/` },
  { label: t(ui.nav.about, locale), href: `/${locale}/${locale === 'fr' ? 'a-propos' : 'about'}/` },
  { label: t(ui.nav.formation, locale), href: `/${locale}/${locale === 'fr' ? 'centre-de-formation' : 'training-centre'}/` },
  { label: t(ui.nav.careers, locale), href: `/${locale}/${locale === 'fr' ? 'carrieres' : 'careers'}/` },
  { label: t(ui.nav.news, locale), href: `/${locale}/${locale === 'fr' ? 'actualites' : 'news'}/` },
  { label: 'FAQ', href: `/${locale}/faq/` },
];

const legalLinks = [
  { label: t(ui.footer.legal, locale), href: `/${locale}/${locale === 'fr' ? 'mentions-legales' : 'legal-notice'}/` },
  { label: t(ui.footer.privacy, locale), href: `/${locale}/${locale === 'fr' ? 'politique-confidentialite' : 'privacy-policy'}/` },
  { label: t(ui.footer.cookies, locale), href: `/${locale}/${locale === 'fr' ? 'politique-cookies' : 'cookies-policy'}/` },
];

const editorialLine = locale === 'fr'
  ? 'Vigilance permanente, depuis Kinshasa.'
  : 'Permanent vigilance, from Kinshasa.';

const labelEntreprise = locale === 'fr' ? 'L’entreprise' : 'Company';
const labelLegal = locale === 'fr' ? 'Légal' : 'Legal';
const labelCoords = t(ui.footer.coordinates, locale);
---

<footer class="site-footer">
  <div class="footer-shell">
    <span class="footer-rail" aria-hidden="true"></span>

    <div class="footer-editorial-block" data-reveal>
      <p class="eyebrow-numbered on-dark footer-editorial-eyebrow">
        <span>Vigilance</span>
        <span>{locale === 'fr' ? 'Établi en 2014 · Kinshasa' : 'Established 2014 · Kinshasa'}</span>
      </p>
      <p class="footer-editorial">
        <span class="footer-editorial-line">{editorialLine}</span>
      </p>
    </div>

    <div class="footer-grid">
      <div class="footer-col footer-col-identity" data-reveal>
        <Logo size="md" variant="on-dark" href={`/${locale}/`} />
        <p class="footer-blurb">
          {locale === 'fr'
            ? 'Société congolaise de gardiennage et de sécurité privée. 11 ans de présence à Kinshasa.'
            : 'Congolese guarding and private-security company. 11 years in Kinshasa.'}
        </p>
        <p class="footer-copyright">© {year} GSS Congo · {t(ui.footer.rights, locale)}</p>
        <ul class="footer-social" aria-label={locale === 'fr' ? 'Réseaux sociaux' : 'Social media'}>
          <li>
            <a href={contact.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-7h2.4l.4-3h-2.8V9c0-.9.2-1.5 1.5-1.5H16V5c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1V11H7v3h2.6v7h3.9Z"/>
              </svg>
            </a>
          </li>
          <li>
            <a href={contact.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5"/>
                <circle cx="12" cy="12" r="3.5"/>
                <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="footer-col" aria-label={labelEntreprise} data-reveal data-reveal-delay="100">
        <h3 class="footer-heading">{labelEntreprise}</h3>
        <ul class="footer-list">
          {companyLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label={labelLegal} data-reveal data-reveal-delay="200">
        <h3 class="footer-heading">{labelLegal}</h3>
        <ul class="footer-list">
          {legalLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer-col footer-col-coords" data-reveal data-reveal-delay="300">
        <h3 class="footer-heading">{labelCoords}</h3>
        <div class="footer-address">
          <p class="footer-address-label">{t(ui.footer.hq, locale)}</p>
          <p>{contact.addresses.hq.street}<br />{contact.addresses.hq.detail}<br />{contact.addresses.hq.city}</p>
        </div>
        <div class="footer-address">
          <p class="footer-address-label">{t(ui.footer.trainingCenter, locale)}</p>
          <p>{contact.addresses.training.street}<br />{contact.addresses.training.detail}<br />{contact.addresses.training.city}</p>
        </div>
        <div class="footer-phones">
          <a href={`tel:${contact.phones.primary.tel}`} class="footer-phone-primary">
            {contact.phones.primary.display}
          </a>
          <a href={`mailto:${contact.email}`} class="footer-email">
            {contact.email}
          </a>
        </div>
        <p class="footer-hours">{contact.hours[locale]}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal-ids">
        <span>RCCM&nbsp;{contact.legal.rccm}</span>
        <span>IDNAT&nbsp;{contact.legal.idnat}</span>
        <span>N° Impôt&nbsp;{contact.legal.taxId}</span>
      </div>
      <p class="footer-credit">
        {t(ui.footer.builtBy, locale)}
        <a class="footer-telic" href="https://telic.studio" target="_blank" rel="noopener noreferrer">
          <img
            src="/images/telic-mark.gif"
            alt=""
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
          />
          <span class="telic-word"><span class="telic-accent">t</span>elic<span class="telic-accent">.</span></span>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Edge-to-edge dark band; inner content is constrained to a max-width. */
  .site-footer {
    position: relative;
    background:
      radial-gradient(35% 120px at 50% 0%, oklch(100% 0 0 / 0.06), transparent 70%),
      var(--color-ink);
    color: var(--color-cream);
    border-top: 1px solid var(--color-hairline-on-dark);
    isolation: isolate;
  }
  .footer-shell {
    position: relative;
    max-width: 1440px;
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3.25rem) clamp(1.25rem, 4vw, 3rem) clamp(1.25rem, 2.5vw, 2rem);
  }
  /* Subtle highlight rail at the very top of the rounded shell */
  .footer-rail {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 33%;
    height: 1px;
    border-radius: 9999px;
    background: oklch(100% 0 0 / 0.18);
    filter: blur(1px);
    pointer-events: none;
  }

  /* Editorial slogan band — compact */
  .footer-editorial-block {
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--color-hairline-on-dark);
    display: grid;
    gap: 0.75rem;
  }
  .footer-editorial-eyebrow { margin: 0; }
  .footer-editorial {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 80, 'wght' 420, 'SOFT' 40;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.05;
    color: var(--color-cream);
    max-width: 22em;
    margin: 0;
    letter-spacing: -0.015em;
  }
  .footer-editorial-line {
    display: inline;
    background-image: linear-gradient(transparent 60%, oklch(40% 0.08 70 / 0.18) 60%);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition: background-size 1.4s var(--ease-out-expo);
  }
  .footer-editorial-block:hover .footer-editorial-line,
  .footer-editorial-block:focus-within .footer-editorial-line {
    background-size: 100% 100%;
  }

  /* 4-column grid: Identity | Entreprise | Légal | Coords */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--color-hairline-on-dark);
  }
  @media (min-width: 640px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 2fr) minmax(0, 2fr) minmax(0, 3fr);
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }

  .footer-col { min-width: 0; }
  .footer-col-identity {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 24em;
  }

  .footer-blurb {
    margin: 0;
    color: var(--color-mute-on-dark);
    font-size: 0.9375rem;
    line-height: 1.6;
    max-width: 22em;
  }
  .footer-copyright {
    margin: 0;
    color: var(--color-mute-on-dark);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }

  .footer-social {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.625rem;
  }
  .footer-social a {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    color: var(--color-cream);
    border: 1px solid var(--color-hairline-on-dark);
    transition: all var(--duration-normal) var(--ease-out-expo);
  }
  .footer-social a:hover {
    border-color: var(--color-bronze-warm);
    color: var(--color-bronze-warm);
  }
  .footer-social svg { width: 1rem; height: 1rem; }

  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-warm);
    margin: 0 0 1rem;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .footer-list a {
    color: var(--color-cream);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-normal) var(--ease-out-expo);
    display: inline-block;
  }
  .footer-list a:hover {
    color: var(--color-bronze-warm);
    transform: translateX(2px);
  }

  /* Coordonnées column */
  .footer-col-coords { font-size: 0.875rem; line-height: 1.6; color: var(--color-cream); }
  .footer-address { margin-bottom: 1rem; }
  .footer-address p { margin: 0; }
  .footer-address-label {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-mute-on-dark);
    margin: 0 0 0.4rem !important;
  }
  .footer-phones {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 1rem 0;
  }
  .footer-phone-primary {
    color: var(--color-bronze-warm);
    text-decoration: none;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .footer-email {
    color: var(--color-cream);
    text-decoration: none;
    font-size: 0.875rem;
    word-break: break-all;
  }
  .footer-email:hover,
  .footer-phone-primary:hover { color: var(--color-bronze-gold); }
  .footer-hours {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--color-mute-on-dark);
    font-variant-numeric: tabular-nums;
  }

  /* Bottom strip */
  .footer-bottom {
    display: grid;
    gap: 0.625rem;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-size: 0.8125rem;
    color: var(--color-mute-on-dark);
  }
  @media (min-width: 768px) {
    .footer-bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-legal-ids {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .footer-credit {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* telic. lockup — animated mark (top slab recoloured to the site's
     bronze) + wordmark in the telic brand colours: purple t + dot,
     cream body on the dark footer. */
  .footer-telic {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    transition: opacity var(--duration-normal) var(--ease-out-expo);
  }
  .footer-telic:hover { opacity: 0.8; }
  .footer-telic img {
    width: 44px;
    height: 44px;
    display: block;
  }
  .telic-word {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    color: var(--color-cream);
  }
  .telic-accent { color: var(--color-bronze-warm); }
</style>
