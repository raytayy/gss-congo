---
/*
 * KpiStrip — vertical pull-quote rebuild (impeccable craft, 2026-05-04).
 * Each stat is a stacked composition: index pip · giant Fraunces value ·
 * unit on its own line · label as eyebrow caption · bronze hairline divider.
 */

interface Kpi {
  value: string;
  unit?: string;
  label: string;
}

interface Props {
  kpis: Kpi[];
}

const { kpis } = Astro.props;
---

<section class="kpi-strip" aria-label="Chiffres clés">
  <div class="kpi-grid">
    {kpis.map((k, i) => (
      <article class="kpi-item" data-reveal data-reveal-delay={String(i * 100)}>
        <span class="kpi-index" aria-hidden="true">/ {String(i + 1).padStart(2, '0')}</span>
        <div class="kpi-stat">
          <strong class="kpi-value" data-counter={k.value} data-counter-display={k.value}>
            {k.value}
          </strong>
          {k.unit && <span class="kpi-unit">{k.unit}</span>}
        </div>
        <span class="kpi-label">{k.label}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .kpi-strip {
    background: var(--color-ink);
    color: var(--color-cream);
    padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }
  .kpi-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 50% at 0% 0%, oklch(20% 0.04 250 / 0.6), transparent 60%),
      radial-gradient(60% 40% at 100% 100%, oklch(40% 0.06 70 / 0.18), transparent 70%);
    pointer-events: none;
  }

  .kpi-grid {
    position: relative;
    max-width: 1440px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 640px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .kpi-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .kpi-item {
    position: relative;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: clamp(14rem, 28vw, 22rem);
    border-top: 1px solid var(--color-hairline-on-dark);
  }
  .kpi-item::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    bottom: 1.75rem;
    left: 0;
    width: 1px;
    background: var(--color-hairline-on-dark);
  }
  .kpi-item:first-child::before { display: none; }
  @media (max-width: 639px) {
    .kpi-item::before { display: none; }
  }
  @media (min-width: 640px) and (max-width: 1023px) {
    .kpi-item:nth-child(odd)::before { display: none; }
  }

  .kpi-index {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-bronze-warm);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .kpi-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-top: auto;
  }

  .kpi-value {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144, 'wght' 380, 'SOFT' 80;
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--color-cream);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .kpi-unit {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 32, 'wght' 460;
    font-style: italic;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    color: var(--color-bronze-warm);
    letter-spacing: -0.005em;
  }

  .kpi-label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-mute-on-dark);
    font-weight: 500;
    margin-top: 0.5rem;
    padding-top: 0.875rem;
    position: relative;
  }
  .kpi-label::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 1.75rem;
    height: 1px;
    background: var(--color-bronze);
    opacity: 0.85;
  }
</style>
