# =============================================================================
# GSS Congo — Apache configuration (GoDaddy cPanel shared hosting)
# Astro 5 static output. Target: https://gss-congo.com
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Force HTTPS + canonical apex domain (strip www.)
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Strip www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Trailing slash policy: add trailing slash for directory-style URLs
  # (matches Astro static output: /services/ resolves to /services/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# 2. Security headers (mod_headers)
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Content Security Policy
  # TODO: replace 'unsafe-inline' on script-src with nonce-based CSP once
  # a server-side rendering hop or edge function is available. Astro static
  # output cannot mint per-request nonces from Apache alone, so inline
  # JSON-LD requires 'unsafe-inline' for now.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; media-src 'self'; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://api.web3forms.com https://*.supabase.co wss://*.supabase.co https://www.facebook.com https://connect.facebook.net; frame-src 'self' https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com; frame-ancestors 'self'; upgrade-insecure-requests"

  # Transport security — 2 years, include subdomains, eligible for preload list
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy — disable powerful features by default + opt out of FLoC
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Remove server fingerprint
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# 3. Compression (mod_deflate)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# 4. Browser caching (mod_expires)
#    - Hashed Astro assets + media: 1 year (immutable)
#    - HTML: 5 minutes (allow quick content updates)
#    - sitemap*.xml: 1 day
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                                "access plus 1 month"

  # HTML — short cache so content updates propagate quickly
  ExpiresByType text/html                       "access plus 5 minutes"

  # CSS / JS — Astro fingerprints these in /_astro/, safe to cache long
  ExpiresByType text/css                        "access plus 1 year"
  ExpiresByType application/javascript          "access plus 1 year"
  ExpiresByType application/x-javascript        "access plus 1 year"

  # Images
  ExpiresByType image/jpeg                      "access plus 1 year"
  ExpiresByType image/png                       "access plus 1 year"
  ExpiresByType image/webp                      "access plus 1 year"
  ExpiresByType image/avif                      "access plus 1 year"
  ExpiresByType image/svg+xml                   "access plus 1 year"
  ExpiresByType image/x-icon                    "access plus 1 year"

  # Video / audio
  ExpiresByType video/mp4                       "access plus 1 year"
  ExpiresByType video/webm                      "access plus 1 year"
  ExpiresByType audio/mpeg                      "access plus 1 year"

  # Fonts
  ExpiresByType font/woff                       "access plus 1 year"
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType font/ttf                        "access plus 1 year"
  ExpiresByType font/otf                        "access plus 1 year"
  ExpiresByType application/font-woff           "access plus 1 year"
  ExpiresByType application/font-woff2          "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject   "access plus 1 year"

  # Manifest / data
  ExpiresByType application/manifest+json       "access plus 1 week"
  ExpiresByType application/json                "access plus 0 seconds"
  ExpiresByType application/ld+json             "access plus 0 seconds"

  # XML feeds / sitemaps
  ExpiresByType application/xml                 "access plus 1 day"
  ExpiresByType text/xml                        "access plus 1 day"
</IfModule>

# Path-specific cache override
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "^sitemap.*\.xml$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# 5. MIME types (ensure modern formats are served correctly)
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/avif                  .avif
  AddType image/svg+xml               .svg
  AddType video/mp4                   .mp4
  AddType video/webm                  .webm
  AddType font/woff                   .woff
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
  AddType application/ld+json         .jsonld
  AddType application/xml             .xml
</IfModule>

# -----------------------------------------------------------------------------
# 6. Error pages
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# 7. Hardening — block access to dotfiles and sensitive files
# -----------------------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|ini|conf|bak|sql|swp|gitignore|gitattributes)$">
  Require all denied
</FilesMatch>

# Allow the standard .well-known directory (Let's Encrypt, security.txt, etc.)
<IfModule mod_alias.c>
  RedirectMatch 200 ^/\.well-known/
</IfModule>

# Disable directory listing
Options -Indexes

# Default character set
AddDefaultCharset UTF-8
