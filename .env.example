# GSS Congo — environment variables (template).
# Copy to .env and fill in real values. Never commit .env (already in .gitignore).

# ─── Contact form ──────────────────────────────────────────────────────
# web3forms.com — free 250 submissions/month. Sign up, paste your key.
# PUBLIC_ prefix exposes it to the client (it's safe — keys are bound to
# your destination email).
PUBLIC_WEB3FORMS_KEY=your-web3forms-key-here

# ─── Social live feed (Meta Graph API v19) ─────────────────────────────
# Powers the "Nos activités" section. Build-time fetch; tokens stay
# server-side. When any of these are missing, the section gracefully
# falls back to platform CTAs (no live posts shown).
#
# SETUP (one-time):
#   1. Convert Instagram account to Business or Creator
#   2. Link IG to a Facebook Page (Meta Business Suite)
#   3. Create a Meta App at https://developers.facebook.com (Business type)
#   4. Grant permissions: instagram_basic, pages_show_list, pages_read_engagement
#   5. Generate a long-lived access token (60-day expiry — refresh strategy needed)
#   6. Note your IG-user-id and FB-page-id from the Graph API Explorer
#
# Token rotation: long-lived tokens last 60 days. Set a calendar reminder
# OR add a GitHub Action to refresh + redeploy nightly.

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
